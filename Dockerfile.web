# syntax=docker/dockerfile:1.7
# Caspira CRM web (SPA) image — Backend Phase 13.
# Build args are PUBLIC configuration only (API base URL and feature-mode
# flags compiled into the bundle); secrets never go into build args.
ARG NODE_IMAGE=node:22.20.0-alpine3.22@sha256:aa83e8f13963f17f7f6bd497085112bf12ea6f20b4b826d9b33f2d99594325b6
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28.0-alpine3.21@sha256:a6bd0e0995ab4723fb65068665f8016decb67dc6a6a32eddc415c7d1229cada6

FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.js eslint.config.js ./
COPY public ./public
COPY src ./src
COPY .env.production ./.env.production
ARG VITE_BACKEND_API_BASE_URL
ENV VITE_BACKEND_API_BASE_URL=${VITE_BACKEND_API_BASE_URL}
# Production bundle without source maps.
RUN npx vite build --mode production --sourcemap false \
 && find dist -name '*.map' -delete

FROM ${NGINX_IMAGE} AS runtime
ARG VERSION=0.0.0-dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="caspira-crm-web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/SpiderMonkeyxOxO-pixie/CaspiraCRM"
COPY --chown=root:root deploy/production/web/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=root:root /app/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]
