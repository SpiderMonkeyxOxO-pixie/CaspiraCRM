VITE_API_BASE_URL=https://api.never777skipyourwork25.qpon/api/v1

# Build settings for the live site (vite build / the GitHub deploy). Only
# public values belong here — everything in a VITE_ variable is visible in
# the browser. Local `npm run dev` doesn't read this file; tests pin these
# flags off in vite.config.js.
#
# The backend runs on the database VPS behind api.caspirasolutions.com
# (docs/VPS_PROD_SETUP.md).
VITE_BACKEND_API_BASE_URL=https://api.caspirasolutions.com/api/v1
VITE_BACKEND_AUTH_MODE=true
VITE_BACKEND_CRM_MODE=true
VITE_BACKEND_CRM_SALES_MODE=true
VITE_BACKEND_SUPPORT_MODE=true
VITE_BACKEND_PROJECTS_MODE=true
VITE_BACKEND_FINANCE_MODE=true
VITE_BACKEND_INTEGRATIONS_MODE=true
