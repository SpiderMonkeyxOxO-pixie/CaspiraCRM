DATABASE_URL="postgresql://caspira:caspira_dev_password@localhost:5434/caspira_crm?schema=public"
PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# AI gateway — leave blank to leave that provider "not configured".
# At least one key is required for /api/v1/ai/narrative and
# /api/v1/ai/explore; none are required for the rest of the backend.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# --- Backend Phase 1: Docker Foundation, Auth, Organizations, RBAC ---
# Redis (BullMQ worker queue + rate limiting). Overridden to redis://redis:6379
# automatically inside Docker Compose — this value is for running the api/
# worker directly on the host instead.
REDIS_URL=redis://127.0.0.1:6379

# Mailpit (local-only transactional email — never a real provider).
# Overridden to mailpit/1025 automatically inside Docker Compose.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM="Caspira CRM <no-reply@caspira-crm.local>"

# Session lifetimes for the new cookie-based /api/v1/auth/* surface.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Host-side Mailpit ports (docker-compose.yml only — not read by the app
# itself). Non-default because this machine already runs an unrelated
# mail-catcher on port 1025.
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8025

# Host-side Postgres port (docker-compose.yml only). Non-default because
# this machine already runs two native PostgreSQL services on 5432/5433.
DB_PORT=5434

# System Owner bootstrap (scripts/bootstrapSystemOwner.js) — leave unset
# for ordinary local dev (the seed script's fixed dev accounts are enough).
# Required together, with NO default password, to run the script for real:
# ALLOW_SYSTEM_OWNER_BOOTSTRAP=true
# BOOTSTRAP_OWNER_EMAIL=owner@yourcompany.example
# BOOTSTRAP_OWNER_USERNAME=owner
# BOOTSTRAP_OWNER_PASSWORD=
# --- Integrations (Backend Phase 8) ---
# live | simulator. Production must be "live"; simulator is local dev only.
INTEGRATIONS_MODE=simulator
# Master encryption keyring for provider credentials: "1:<base64 32 bytes>".
# It lives only here (or in a Docker secret via INTEGRATIONS_KEYS_FILE) —
# never in the database. The api and worker refuse to start without it.
# Generate one with:  openssl rand -base64 32
# Rotation: add "2:<new key>", set INTEGRATIONS_ACTIVE_KEY_VERSION=2,
# restart, run `npm run integrations:verify-encryption -- --rewrap`, then
# remove version 1. See docs/BACKEND_PHASE8.md.
INTEGRATIONS_KEYS=
# INTEGRATIONS_ACTIVE_KEY_VERSION=1
# Public base URL providers call back to (OAuth redirect and webhooks).
INTEGRATIONS_PUBLIC_API_URL=http://localhost:4000
# Where the browser is sent after an OAuth callback (pre-registered only).
INTEGRATIONS_FRONTEND_URL=http://localhost:5173
# ── Backend Phase 13 — environments, sessions, HTTP hardening, platform ops ──
# Profile: development | test | staging | production. Staging and production
# are strict: they read secrets from files (/run/secrets or NAME_FILE) and
# refuse to start on weak or missing configuration. Production and staging
# use deploy/production/env/*.env.example instead of this file.
APP_ENV=development
# Reverse-proxy hops to trust (a count or CIDRs, never "true"). Unset locally.
# TRUST_PROXY=1
# Sessions: idle refresh lifetime, absolute lifetime from password login, and
# how recently a password must be confirmed for sensitive platform actions.
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_ABSOLUTE_TTL_DAYS=30
# RECENT_AUTH_MINUTES=10
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# HSTS_ENABLED=false
# API_REQUEST_TIMEOUT_MS=120000
# API_RATE_LIMIT_PER_MINUTE=
# Platform operations (System Owner): allow audited self-approval only where
# one operator is all the staffing there is (keep false where possible).
PLATFORM_ALLOW_SINGLE_OPERATOR=false
# Hashes automation tokens (cpat_…); required in staging/production.
# PLATFORM_AUTOMATION_TOKEN_PEPPER=
# Backup agent control volume (production stack only; unset in development).
# BACKUP_CONTROL_DIR=
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_TO=
