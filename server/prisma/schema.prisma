  organization          Organization?           @relation("OrganizationPriceBooks", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId     String?
  ownerMembership       OrganizationMembership? @relation("OwnedPriceBooks", fields: [ownerMembershipId], references: [id])
  createdByMembershipId String?
  updatedByMembershipId String?
