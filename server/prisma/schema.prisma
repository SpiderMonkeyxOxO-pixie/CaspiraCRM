// ---------------------------------------------------------------------------
// Backend Phase 11 — AI governance, safety operations, evaluation management
// and staged rollout. Platform-level records (capabilities, prompts, tools,
// workflows, models) have organizationId null; tenant records carry it.
// `scope` is the organizationId or "platform" (unique keys can't use NULL).
// Actors are users (a System Owner may act without a membership).
// ---------------------------------------------------------------------------

model AiCapability {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  description        String
  purpose            String
  // Low | Moderate | High | Prohibited
  riskLevel          String
  // { business: userId|label, technical, risk }
  owners             Json      @default("{}")
  // "all_opted_in" | [organizationId]
  organizationScope  Json      @default("[]")
  roles              Json      @default("[]")
  modules            Json      @default("[]")
  // { permitted: [], prohibited: [] }
  dataClassifications Json     @default("{}")
  providers          Json      @default("[]")
  models             Json      @default("[]")
  promptVersions     Json      @default("[]")
  toolVersions       Json      @default("[]")
  workflowVersions   Json      @default("[]")
  requiredApprovals  Json      @default("[]")
  evaluationSuiteKey String?
  retentionPolicy    Json      @default("{}")
  budgetPolicy       Json      @default("{}")
  // Not configured | Draft | Under review | Changes requested | Approved | Evaluation failed |
  // Ready for pilot | Pilot | Canary | Generally available | Paused | Blocked | Rolled back | Retired
  status             String    @default("Draft")
  currentReleaseId   String?
  lastReviewAt       DateTime?
  nextReviewAt       DateTime?
  sunsetAt           DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("ai_capabilities")
}

model AiCapabilityVersion {
  id            String   @id @default(cuid())
  capabilityId  String
  version       Int
  snapshot      Json
  changeSummary String
  createdByUserId String?
  createdAt     DateTime @default(now())

  @@unique([capabilityId, version])
  @@map("ai_capability_versions")
}

model AiGovernancePolicy {
  id              String    @id @default(cuid())
  publicId        String    @unique
  organizationId  String?
  scope           String
  capabilityKey   String?
  name            String
  riskLevel       String
  // Draft | Submitted | Under review | Changes requested | Approved | Active | Paused | Superseded | Retired
  status          String    @default("Draft")
  activeVersionId String?
  latestVersion   Int       @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([scope, status])
  @@map("ai_governance_policies")
}

model AiGovernancePolicyVersion {
