  market              String?
  customerSegment     String?
  companyIds          Json      @default("[]")
  salesChannel        String?
  categories          Json      @default("[]")
  dealTypes           Json      @default("[]")
  contractTypes       Json      @default("[]")
  effectiveDate       DateTime?
  expirationDate      DateTime?
  ownerId             String?
  owner               User?     @relation("PriceBookOwner", fields: [ownerId], references: [id])
  tags                Json      @default("[]")
  archived            Boolean   @default(false)
  archiveReason       String?
  archivedAt          DateTime?
  statusBeforeArchive String?
  activityLog         Json      @default("[]")
  auditLog            Json      @default("[]")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  entries PriceBookEntry[]
  quotes  Quote[]

