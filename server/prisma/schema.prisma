  deliveryInstructions      String?
  serviceStartInstructions  String?
  customerReference         String?
  internalNote              String?
  customerNote              String?
  cancellationReason        String?
  cancellationEffectiveDate DateTime?
  holdReason                String?
  holdReviewDate            DateTime?
