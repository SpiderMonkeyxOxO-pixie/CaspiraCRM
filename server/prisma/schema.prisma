  // Live | Simulator
  mode                    String?
  promptTemplateVersionId String?
  // Phase 11 attribution: governed capability, release and rollout cohort
  capabilityKey           String?
  releaseId               String?
  safetyIdVersion         String?
  moderation              Json?
  // Queued | Running | Streaming | Completed | Completed with Warnings | Failed | Cancelled | Refused
  status                  String    @default("Queued")
  errorCategory           String?
  safeError               String?
  providerRequestId       String?
  inputChars              Int       @default(0)
  outputChars             Int       @default(0)
  removedFields           Json      @default("[]")
  injectionFlags          Json      @default("[]")
