// ---------------------------------------------------------------------------
// Backend Phase 3 — Sales Pipeline, Deals, Catalog, Quotes, Orders, Contracts
// New models: Pipeline/PipelineStage (org-configurable, none existed before),
// DealStageHistory (append-only), SalesApproval (generic, focused approval
// model — no shared approval system exists anywhere else in this codebase),
// ContractObligation/ContractRenewalReview, SalesDocumentCounter (org+docType
// scoped, concurrency-safe sequential document numbers).
// ---------------------------------------------------------------------------

model Pipeline {
  id             String    @id @default(cuid())
  publicId       String?   @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  currencyPolicy String?   // e.g. "USD" default currency for Deals created in this Pipeline, or null (any)
  isDefault      Boolean   @default(false)
  active         Boolean   @default(true)
  wipLimits      Json?     // e.g. { "Negotiation": 6 } — per-Stage-name WIP caps, frontend-only enforcement today
  createdByMembershipId String?
  updatedByMembershipId String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId])
  @@map("sales_pipelines")
}

model PipelineStage {
  id             String    @id @default(cuid())
  publicId       String?   @unique
  organizationId String
  pipelineId     String
  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  displayOrder   Int       @default(0)
  // Open | Won | Lost | Cancelled | OnHold — superset of the spec's
  // suggested Open/Won/Lost, matching the frontend's real DEAL_STATUSES.
  classification String    @default("Open")
  probability    Int       @default(0) // 0-100, enforced in application code
  requiredFields Json      @default("[]")
  entryRules     Json      @default("[]")
  exitRules      Json      @default("[]")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  deals Deal[]

  @@index([organizationId])
  @@index([pipelineId])
  @@map("sales_pipeline_stages")
}

// Append-only — no route ever updates or deletes a row here. Snapshots the
// Stage names/probabilities AT THE TIME of the change so a later Stage rename
// or probability edit never rewrites historical meaning.
model DealStageHistory {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String?
  fromStageId    String?
  fromStageName  String?
  fromProbability Int?
  toStageId      String?
  toStageName    String?
  toProbability  Int?
  changedByMembershipId String?
  changedAt      DateTime  @default(now())
  reason         String?
  timeInPreviousStageSeconds Int?
  correlationId  String?

  @@index([dealId])
  @@index([organizationId])
  @@map("deal_stage_history")
}

model SalesApproval {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   String    // "Quote" this phase; generic enough to extend later
  resourceId     String
  quoteId        String?
  quote          Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedByMembershipId String
  requiredPermissionOrRole String?
  reason         String?
  snapshot       Json      @default("{}")
  status         String    @default("Pending") // Pending | Approved | Rejected
  decidedByMembershipId String?
  decisionReason String?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([quoteId])
  @@map("sales_approvals")
}

model ContractObligation {
  id             String    @id @default(cuid())
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organizationId String?
  title          String
  description    String?
  ownerMembershipId String?
  dueDate        DateTime?
  status         String    @default("Open") // Open | In Progress | Completed | Overdue | Waived | Cancelled
  completedDate  DateTime?
  completedByMembershipId String?
  waiveReason    String?
  evidenceNote   String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contractId])
  @@index([organizationId])
  @@map("contract_obligations")
}

model ContractRenewalReview {
  id             String    @id @default(cuid())
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  renewalOwnerMembershipId String?
  renewalNoticeDeadline DateTime?
  proposedStartDate DateTime?
  proposedEndDate DateTime?
  proposedValue  Decimal?  @db.Decimal(14, 2)
  decision       String?   // Renew | Do Not Renew | Renegotiate
  decisionReason String?
  decidedByMembershipId String?
  decidedAt      DateTime?
  relatedNewContractId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contractId])
  @@map("contract_renewal_reviews")
}

model SalesDocumentCounter {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        String    // Deal | Quote | Order | Contract
  value          Int       @default(0)

  @@unique([organizationId, docType])
  @@map("sales_document_counters")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------
model Ticket {
  id             String    @id @default(cuid())
  ticketNumber   String    @unique
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  subject        String
  description    String?
  source         String    @default("Portal")
  category       String    @default("General")
  priority       String    @default("Medium")
  department     String    @default("Support")
  assignedAgentId String?
  assignedAgent  User?     @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  status         String    @default("New")
  slaResponseDeadline DateTime?
  slaResolutionDeadline DateTime?
  firstRespondedAt DateTime?
  publicReplies  Json      @default("[]")
  privateNotes   Json      @default("[]")
  escalations    Json      @default("[]")
  resolutionSummary String?
  resolvedAt     DateTime?
  csatScore      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------
model Project {
  id             String    @id @default(cuid())
  name           String
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  status         String    @default("Planning")
  ownerId        String?
  owner          User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  startDate      DateTime?
  dueDate        DateTime?
  description    String?
  customerVisible Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  milestones Milestone[]
  tasks      Task[]

  @@map("projects")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dueDate   DateTime?
  completed Boolean  @default(false)

  @@map("milestones")
}

model Task {
  id            String    @id @default(cuid())
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  assigneeId    String?
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  watchers      Json      @default("[]")
  priority      String    @default("Medium")
  status        String    @default("To Do")
  dueDate       DateTime?
  estimateHours Float?
  loggedHours   Float     @default(0)
  timeEntries   Json      @default("[]")
  dependsOnId   String?
  dependsOn     Task?     @relation("TaskDependency", fields: [dependsOnId], references: [id])
  blockedTasks  Task[]    @relation("TaskDependency")
  recurring     Boolean   @default(false)
  comments      Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------
model Campaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    @default("Email")
  status    String    @default("Draft")
  startDate DateTime?
  endDate   DateTime?
  budget    Float?
  goal      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]
  forms MarketingForm[]

  @@map("campaigns")
}

model Segment {
  id        String   @id @default(cuid())
  name      String
  field     String
  value     String
  createdAt DateTime @default(now())

  @@map("segments")
}

model MarketingForm {
  id          String   @id @default(cuid())
  name        String
  fields      Json     @default("[]")
  submissions Int      @default(0)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("marketing_forms")
}

model MarketingTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String?
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketing_templates")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id])
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  items         Json     @default("[]")
  currency      String   @default("USD")
  subtotal      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  amountPaid    Float    @default(0)
  amountDue     Float    @default(0)
  status        String   @default("Draft")
  approvedBy    String?
  voidReason    String?
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments    Payment[]
  creditNotes CreditNote[]

  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("Bank Transfer")
  date      DateTime @default(now())

  @@map("payments")
}

model CreditNote {
  id              String   @id @default(cuid())
  creditNoteNumber String  @unique
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  companyName     String?
  amount          Float
  reason          String?
  createdAt       DateTime @default(now())

  @@map("credit_notes")
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  description   String?
  category      String   @default("Other")
  amount        Float
  submittedById String?
  submittedBy   User?    @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  status        String   @default("Pending")
  reviewedBy    String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("expenses")
}

model RecurringInvoice {
  id               String    @id @default(cuid())
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  items            Json      @default("[]")
  interval         String    @default("Monthly")
  active           Boolean   @default(true)
  lastGeneratedAt  DateTime?
  invoicesGenerated Int      @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("recurring_invoices")
}
