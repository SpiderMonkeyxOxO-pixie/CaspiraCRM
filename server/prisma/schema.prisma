  organization             Organization?           @relation("OrganizationContracts", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId        String?
  ownerMembership          OrganizationMembership? @relation("OwnedContracts", fields: [ownerMembershipId], references: [id])
  renewalOwnerMembershipId String?
  renewalOwnerMembership   OrganizationMembership? @relation("RenewalOwnedContracts", fields: [renewalOwnerMembershipId], references: [id])
  createdByMembershipId    String?
  updatedByMembershipId    String?
