model PriceBookEntry {
  id              String      @id @default(cuid())
  priceBookId     String
  priceBook       PriceBook   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  catalogItemId   String
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id])
  currency        String      @default("USD")
  adjustmentType  String      @default("Fixed Price")
  adjustmentValue Decimal     @default(0) @db.Decimal(14, 2)
  tiers           Json        @default("[]")
  minQuantity     Int?
  maxQuantity     Int?
  billingInterval String?
  effectiveDate   DateTime?
  expirationDate  DateTime?
  notes           String?
  enabled         Boolean     @default(true)

  // --- Backend Phase 3 additions ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priceBookId])
  @@index([catalogItemId])
  @@map("price_book_entries")
}

model Quote {
  id                  String     @id @default(cuid())
  quoteNumber         String
  title               String?
  version             Int        @default(1)
  rootId              String?
  status              String     @default("Draft")
  approvalStatus      String?
  companyId           String?
  company             Company?   @relation(fields: [companyId], references: [id])
  primaryContactId    String?
  contact             Contact?   @relation(fields: [primaryContactId], references: [id])
  dealId              String?
  deal                Deal?      @relation(fields: [dealId], references: [id])
  priceBookId         String?
  priceBook           PriceBook? @relation(fields: [priceBookId], references: [id])
  ownerId             String?
  owner               User?      @relation("QuoteOwner", fields: [ownerId], references: [id])
  assignedTeam        String?
  currency            String     @default("USD")
  validUntilDate      DateTime?
  paymentTerms        String?
  billingSchedule     String?
  customerNote        String?
  internalNote        String?
  customerResponse    Json?
  changeSummary       String?
  archived            Boolean    @default(false)
  archiveReason       String?
  archivedAt          DateTime?
  statusBeforeArchive String?
  activityLog         Json       @default("[]")
  auditLog            Json       @default("[]")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  lineItems QuoteLineItem[]
  orders    Order[]
  contracts Contract[]

  // --- Backend Phase 3 additions ---
  organizationId         String?
  organization           Organization?           @relation("OrganizationQuotes", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId      String?
  ownerMembership        OrganizationMembership? @relation("OwnedQuotes", fields: [ownerMembershipId], references: [id])
  createdByMembershipId  String?
  updatedByMembershipId  String?
  approvedByMembershipId String?
  approvedAt             DateTime?
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  supersededByQuoteId    String?
  subtotal               Decimal?                @db.Decimal(14, 2)
  discountTotal          Decimal?                @db.Decimal(14, 2)
  taxTotal               Decimal?                @db.Decimal(14, 2)
  grandTotal             Decimal?                @db.Decimal(14, 2)
  archivedByMembershipId String?
  // Quote document fields from the Quote builder (frontend-to-backend Step 5c).
  issueDate              DateTime?
  overallDiscountType    String?
  serviceStartEstimate   String?
  minimumCommitment      String?
  termsAndConditions     String?
  assumptions            String?
  documentLayout         Json?
  // Recipient/subject/message recorded when the quote was issued; no email is sent.
  sendPreview            Json?
  // Named rowVersion (not "version") because Quote.version already carries
  // the business meaning "this quote's version number" — optimistic
  // concurrency needs its own counter, distinct from that.
  rowVersion             Int                     @default(1)

  approvals SalesApproval[]

  @@unique([organizationId, quoteNumber, version])
  @@index([organizationId])
  @@index([dealId])
  @@index([rootId])
  @@map("quotes")
}

model QuoteLineItem {
  id              String       @id @default(cuid())
  quoteId         String
  quote           Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItemId   String?
  catalogItem     CatalogItem? @relation(fields: [catalogItemId], references: [id])
  priceBookIdUsed String?
  isCustomLine    Boolean      @default(false)
  included        Boolean      @default(true)
  name            String
  description     String?
  unit            String       @default("Each")
  billingModel    String       @default("One Time")
  billingInterval String?
  quantity        Float        @default(1)
  listPrice       Decimal      @default(0) @db.Decimal(14, 2)
  priceBookPrice  Decimal?     @db.Decimal(14, 2)
  unitPrice       Decimal      @default(0) @db.Decimal(14, 2)
  discountType    String?
  discountValue   Decimal?     @db.Decimal(14, 2)
  taxCategory     String       @default("Standard")
  // Section heading grouping lines on the Quote document (frontend-to-backend Step 5c).
  sectionTitle    String?
  order           Int          @default(0)

  // --- Backend Phase 3 additions ---
  skuSnapshot    String?
  lineSubtotal   Decimal? @db.Decimal(14, 2)
  taxAmount      Decimal? @db.Decimal(14, 2)
  lineTotal      Decimal? @db.Decimal(14, 2)
  isOverridden   Boolean  @default(false)
  overrideReason String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("quote_line_items")
}

model Order {
