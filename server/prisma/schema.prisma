  organizationId           String?
  organization             Organization?           @relation("OrganizationOrders", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId        String?
  ownerMembership          OrganizationMembership? @relation("OwnedOrders", fields: [ownerMembershipId], references: [id])
