  leads Lead[]
  forms MarketingForm[]

  @@map("campaigns")
}

model Segment {
  id        String   @id @default(cuid())
  name      String
  field     String
  value     String
  createdAt DateTime @default(now())

  @@map("segments")
}

model MarketingForm {
