// ============================================================================
// Backend Phase 10 — AI Copilot, conversation memory, permission-aware
// retrieval and governed workflows. The CRM is the system of record for
// conversations; provider-side conversation state is off by default.
// Plain string references, like Phases 8–9. No chain-of-thought is stored.
// ============================================================================

model AiCopilotConversation {
  id                     String    @id @default(cuid())
  publicId               String    @unique
  organizationId         String
  userId                 String?
  membershipId           String
  title                  String
  // ask | briefing | meeting | pipeline | renewal | data_quality | daily
  mode                   String    @default("ask")
  // Active | Archived | Locked | Deleted | Retention pending | Provider unavailable | Restricted
  status                 String    @default("Active")
  departmentId           String?
  teamId                 String?
  // Primary record context: { recordType, recordId, label }
  primaryContext         Json?
  // Deterministic compaction summary (labelled as a summary, never a fact).
  summary                Json?
  summaryThroughSeq      Int       @default(0)
  // CRM (default) | Provider (only by organization policy)
  storageMode            String    @default("CRM")
  providerConversationId String?
  lastMessageAt          DateTime?
  messageCount           Int       @default(0)
  archivedAt             DateTime?
  deletedAt              DateTime?
  retentionUntil         DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([organizationId, membershipId, lastMessageAt])
  @@index([organizationId, status])
  @@index([retentionUntil])
  @@map("ai_copilot_conversations")
}

model AiCopilotMessage {
  id              String    @id @default(cuid())
  organizationId  String
  conversationId  String
  seq             Int
  // user | assistant
  role            String
  // Queued | Classifying | Retrieving | Awaiting tool | Generating | Validating | Completed |
  // Completed with limitations | Cancelled | Refused | Failed | Stale
  status          String    @default("Completed")
  // For assistant messages: the VALIDATED final answer only (never a draft).
  content         String    @default("")
  intent          String?
  // High Confidence | Medium Confidence | Low Confidence | Insufficient Data
  confidence      String?
  limitations     Json      @default("[]")
  freshness       Json?
  requestIds      Json      @default("[]")
  providerKey     String?
  modelId         String?
  promptVersion   String?
  usage           Json?
  errorCategory   String?
  safeError       String?
  parentMessageId String?
  workflowRunId   String?
  idempotencyKey  String?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([conversationId, seq])
  @@unique([organizationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@map("ai_copilot_messages")
}

model AiCopilotMessagePart {
  id             String   @id @default(cuid())
  organizationId String
  messageId      String
  seq            Int
  // finding | limitation | clarification | proposal | workflow | memory_proposal | restricted_notice
