// Caspira CRM — backend schema.
//
// Status/type/category fields are plain String columns validated at the
// application layer (see src/constants/*.js), not native Prisma enums —
// most of the frontend's existing enum values contain spaces and slashes
// ("Pending Review", "Auditor / Checker") that don't map cleanly onto
// Prisma enum identifiers, and the mock layer this replaces already
// validates the same way (a plain array + .includes() check), so this
// keeps parity instead of fighting the schema.
//
// Every model's `id` is exposed to the frontend as `_id` by the API
// serialization layer (src/utils/serialize.js) — the frontend's existing
// Redux thunks and components already expect `_id` everywhere and this
// avoids touching hundreds of already-built frontend files.
//
// Lightweight, always-fetched-with-the-parent structures (activity logs,
// audit logs, notes, file lists, fulfillment notes, amendment history) are
// stored as Json columns rather than child tables — they're never queried
// independently of their parent record in the frontend today. Line items
// and other genuinely relational children get real child tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------
model User {
  id                String    @id @default(cuid())
  name              String
  fullName          String?
  username          String    @unique
  email             String    @unique
  phone             String?
  passwordHash      String
  role              String    @default("User") // Super-Admin | Admin | Team-Leader | Checker | User
  department        String?
  jobTitle          String?
  team              String?
  shift             String?
  status            String    @default("Active")
  workingHour       String?
  avatarUrl         String?
  fcmToken          String?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  resetToken        String?
  resetTokenExpires DateTime?
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles             UserRole[]
  ownedCompanies    Company[]       @relation("CompanyOwner")
  ownedContacts     Contact[]       @relation("ContactOwner")
  ownedLeads        Lead[]          @relation("LeadOwner")
  ownedDeals        Deal[]          @relation("DealOwner")
  ownedActivities   Activity[]      @relation("ActivityOwner")
  ownedCatalogItems CatalogItem[]   @relation("CatalogItemOwner")
  ownedPriceBooks   PriceBook[]     @relation("PriceBookOwner")
  ownedQuotes       Quote[]         @relation("QuoteOwner")
  ownedOrders       Order[]         @relation("OrderOwner")
  ownedContracts    Contract[]      @relation("ContractOwner")
  assignedTickets   Ticket[]        @relation("TicketAgent")
  ownedProjects     Project[]       @relation("ProjectOwner")
  assignedTasks     Task[]          @relation("TaskAssignee")
  submittedExpenses Expense[]       @relation("ExpenseSubmitter")
  portalAccounts    PortalAccount[] @relation("PortalAccountUser")

  memberships             OrganizationMembership[] @relation("MembershipUser")
  refreshSessions         RefreshSession[]         @relation("RefreshSessionUser")
  emailVerificationTokens EmailVerificationToken[] @relation("EmailVerificationUser")
  passwordResetTokens     PasswordResetToken[]     @relation("PasswordResetUser")

  @@map("users")
}

model Role {
  id                        String    @id @default(cuid())
  key                       String?   @unique // maps a built-in role to a real auth role identifier (e.g. "super_admin")
  name                      String
  type                      String    @default("Custom") // Built-in | Custom | Capability | External
  isBuiltIn                 Boolean   @default(false)
  department                String?
  status                    String    @default("Active") // Active | Inactive | Archived
  purpose                   String?
  description               String?
  recommendedScope          String?
  defaultScope              String
  allowedScopes             Json      @default("[]")
  isOrdinaryRecordOwner     Boolean   @default(false)
  customerAccountRestricted Boolean   @default(false)
  permissionGrants          Json      @default("[]") // [{moduleId, actions:[]}]
  sensitiveFields           Json      @default("{}") // {fieldId: state}
  approvalRules             Json      @default("{}") // {approvalTypeId: bool}
  notes                     Json      @default("[]")
  duplicatedFromId          String?
  archiveReason             String?
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  users              UserRole[]
  membershipRoles    MembershipRole[]
  invitations        Invitation[]
  inviteLinkDefaults OrganizationInviteLink[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Backend Phase 1 — Organizations, memberships, invitations, sessions,
// audit and outbox. Additive only: no existing table above is modified, and
// nothing below is queried by any pre-Phase-1 route. `Role` (above) is
// reused as-is for org-scoped role assignment via MembershipRole — this is
// deliberately NOT a second Role table (see docs/BACKEND_PHASE1.md).
// ---------------------------------------------------------------------------
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  status          String   @default("Active") // Active | Suspended | Archived
  createdByUserId String?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships OrganizationMembership[]
  invitations Invitation[]
  inviteLinks OrganizationInviteLink[]
  auditEvents AuditEvent[]

  // Backend Phase 2 — CRM Core Data Persistence
  crmLeads          Lead[]             @relation("OrganizationLeads")
  crmContacts       Contact[]          @relation("OrganizationContacts")
  crmCompanies      Company[]          @relation("OrganizationCompanies")
  crmActivities     Activity[]         @relation("OrganizationActivities")
  tickets           Ticket[]           @relation("OrganizationTickets")
  projects          Project[]          @relation("OrganizationProjects")
  tasks             Task[]             @relation("OrganizationTasks")
  invoices          Invoice[]          @relation("OrganizationInvoices")
  expenses          Expense[]          @relation("OrganizationExpenses")
  recurringInvoices RecurringInvoice[] @relation("OrganizationRecurringInvoices")
  crmNotes          CrmNote[]
  crmTags           CrmTag[]
  crmMerges         RecordMerge[]

  // Backend Phase 3 — Sales Pipeline, Deals, Catalog, Quotes, Orders, Contracts
  salesPipelines        Pipeline[]
  salesDeals            Deal[]                 @relation("OrganizationDeals")
  salesCatalogItems     CatalogItem[]          @relation("OrganizationCatalogItems")
  salesPriceBooks       PriceBook[]            @relation("OrganizationPriceBooks")
  salesQuotes           Quote[]                @relation("OrganizationQuotes")
  salesOrders           Order[]                @relation("OrganizationOrders")
  salesContracts        Contract[]             @relation("OrganizationContracts")
  salesApprovals        SalesApproval[]
  salesDocumentCounters SalesDocumentCounter[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("Invited") // Invited | Active | Suspended | Removed
  invitedAt      DateTime?
  joinedAt       DateTime?
  suspendedAt    DateTime?
  removedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles MembershipRole[]

  // Backend Phase 2 — CRM record ownership/assignment by membership
  // (rather than raw User) so RBAC record-scope checks stay org-consistent.
  ownedLeads         Lead[]     @relation("OwnedLeads")
  ownedContacts      Contact[]  @relation("OwnedContacts")
  ownedCompanies     Company[]  @relation("OwnedCompanies")
  ownedActivities    Activity[] @relation("OwnedActivities")
  assignedActivities Activity[] @relation("AssignedActivities")
  assignedTickets    Ticket[]   @relation("AssignedTickets")
  ownedProjects      Project[]  @relation("OwnedProjects")
  assignedTasks      Task[]     @relation("AssignedTasks")
  createdInvoices    Invoice[]  @relation("CreatedInvoices")
  submittedExpenses  Expense[]  @relation("SubmittedExpenses")
  authoredCrmNotes   CrmNote[]

  // Backend Phase 3 — Sales record ownership by membership
  ownedDeals            Deal[]        @relation("OwnedDeals")
  ownedCatalogItems     CatalogItem[] @relation("OwnedCatalogItems")
  ownedPriceBooks       PriceBook[]   @relation("OwnedPriceBooks")
  ownedQuotes           Quote[]       @relation("OwnedQuotes")
  ownedOrders           Order[]       @relation("OwnedOrders")
  ownedContracts        Contract[]    @relation("OwnedContracts")
  renewalOwnedContracts Contract[]    @relation("RenewalOwnedContracts")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// Ties a Role (the existing, shared catalog above) to a specific
// organization membership — org-scoped, distinct from the global UserRole
// join, which stays system-level (see Backend Phase 1 plan's RBAC section).
model MembershipRole {
  id               String                 @id @default(cuid())
  membershipId     String
  membership       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role                   @relation(fields: [roleId], references: [id])
  assignedByUserId String?
  assignedAt       DateTime               @default(now())

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

model Invitation {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String // normalized lowercase
  invitedByUserId  String
  roleId           String
  role             Role         @relation(fields: [roleId], references: [id])
  department       String?
  team             String?
  message          String?
  tokenHash        String       @unique
  status           String       @default("Pending") // Pending | Accepted | Revoked | Expired
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, email])
  @@map("invitations")
}

model OrganizationInviteLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash        String       @unique
  defaultRoleId    String
  defaultRole      Role         @relation(fields: [defaultRoleId], references: [id])
  expiresAt        DateTime?
  maxUses          Int?
  useCount         Int          @default(0)
  allowedDomains   Json         @default("[]")
  requiresApproval Boolean      @default(false)
  createdByUserId  String
  status           String       @default("Active") // Active | Revoked
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("organization_invite_links")
}

model RefreshSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("RefreshSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  familyId      String
  replacedById  String?
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("EmailVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Append-only. No route ever updates or deletes a row here.
model AuditEvent {
  id                String        @id @default(cuid())
  correlationId     String?
  actorUserId       String?
  actorMembershipId String?
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action            String
  targetType        String?
  targetId          String?
  result            String // Success | Failure | Denied
  reason            String?
  beforeData        Json?
  afterData         Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json      @default("{}")
  status        String    @default("Pending") // Pending | Processing | Sent | Failed | Internal (recorded notification, no email)
  attempts      Int       @default(0)
  lastError     String?
  availableAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processedAt   DateTime?

  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  scope          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------
model Company {
  id                  String    @id @default(cuid())
  name                String
  industry            String?
  website             String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String?
  size                String?
  annualRevenue       Float?
  lifecycleStage      String?   @default("Lead")
  tags                Json      @default("[]")
  ownerId             String?
  owner               User?     @relation("CompanyOwner", fields: [ownerId], references: [id])
  status              String    @default("Active")
  archived            Boolean   @default(false)
  archiveReason       String?
  archivedAt          DateTime?
  statusBeforeArchive String?
  customFields        Json      @default("{}")
  notes               Json      @default("[]")
  activityLog         Json      @default("[]")
  files               Json      @default("[]")
  auditLog            Json      @default("[]")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // --- Backend Phase 2: CRM Core Data Persistence (organization-scoped) ---
  // Nullable, not required: this table has pre-Phase-2 legacy rows (e.g.
  // prisma/seed.js's sample Company) with no organization concept. Every
  // Phase 2 query always filters `WHERE organizationId = ?`, so a null row
  // is simply invisible to the new org-scoped surface rather than breaking
  // a NOT NULL backfill on data that predates organizations entirely.
  organizationId         String?
  organization           Organization?           @relation("OrganizationCompanies", fields: [organizationId], references: [id], onDelete: Cascade)
  legalName              String?
  normalizedName         String?
  normalizedDomain       String?
  companyType            String?
  accountStatus          String?
  employeeSizeRange      String?
  annualRevenueRange     String?
  currency               String?
  region                 String?
  team                   String?
  department             String?
  ownerMembershipId      String?
  ownerMembership        OrganizationMembership? @relation("OwnedCompanies", fields: [ownerMembershipId], references: [id])
  createdByMembershipId  String?
  updatedByMembershipId  String?
  archivedByMembershipId String?
  // Frontend Company form fields with no prior column (frontend-to-backend
  // Step 3). `description` holds free-text notes (`notes` above is Json).
  customerStatus         String?
  accountTier            String?
  accountHealth          String?
  healthReason           String?
  email                  String?
  timeZone               String?
  preferredLanguage      String?
  source                 String?
  estimatedAnnualValue   Decimal?                @db.Decimal(14, 2)
  renewalDate            DateTime?
  nextActionDate         DateTime?
  description            String?
  version                Int                     @default(1)

  contacts             Contact[]
  deals                Deal[]
  activities           Activity[]
  tickets              Ticket[]
  projects             Project[]
  quotes               Quote[]
  orders               Order[]
  contracts            Contract[]
  invoices             Invoice[]
  recurringInvoices    RecurringInvoice[]
  priceBookIds         Json                         @default("[]")
  contactRelationships CompanyContactRelationship[]
  crmNotes             CrmNote[]
  crmTags              CrmRecordTag[]
  vendorProfile        Vendor[]

  @@index([organizationId])
  @@index([normalizedDomain])
  @@index([lifecycleStage])
  @@index([accountStatus])
  @@index([ownerMembershipId])
  @@index([archived])
  @@index([updatedAt])
  @@map("companies")
}

model Contact {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String
  email         String?
  phone         String?
  jobTitle      String?
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  isPrimary     Boolean   @default(false)
  emailConsent  Boolean   @default(false)
  smsConsent    Boolean   @default(false)
  doNotContact  Boolean   @default(false)
  tags          Json      @default("[]")
  ownerId       String?
  owner         User?     @relation("ContactOwner", fields: [ownerId], references: [id])
  status        String    @default("Active")
  archived      Boolean   @default(false)
  archiveReason String?
  archivedAt    DateTime?
  notes         Json      @default("[]")
  activityLog   Json      @default("[]")
  files         Json      @default("[]")
  auditLog      Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Backend Phase 2 additions ---
  organizationId         String?
  organization           Organization?           @relation("OrganizationContacts", fields: [organizationId], references: [id], onDelete: Cascade)
  displayName            String?
  normalizedEmail        String?
  normalizedPhone        String?
  lifecycleStage         String?
  department             String?
  ownerMembershipId      String?
  ownerMembership        OrganizationMembership? @relation("OwnedContacts", fields: [ownerMembershipId], references: [id])
  createdByMembershipId  String?
  updatedByMembershipId  String?
  archivedByMembershipId String?
  emailOptIn             Boolean                 @default(false)
  phoneOptIn             Boolean                 @default(false)
  smsOptIn               Boolean                 @default(false)
  marketingOptIn         Boolean                 @default(false)
  preferredChannel       String?
  preferredLanguage      String?
  country                String?
  region                 String?
  city                   String?
  timeZone               String?
  lastContactDate        DateTime?
  // Frontend Contact form fields with no prior column (frontend-to-backend
  // Step 3). `description` holds free-text notes (`notes` above is Json).
  businessDepartment     String?
  decisionMakingRole     String?
  relationshipType       String?
  source                 String?
  nextActionDate         DateTime?
  doNotContactReason     String?
  description            String?
  version                Int                     @default(1)

  deals                Deal[]
  activities           Activity[]
  tickets              Ticket[]
  quotes               Quote[]
  orders               Order[]
  contracts            Contract[]
  companyRelationships CompanyContactRelationship[]
  crmNotes             CrmNote[]
  crmTags              CrmRecordTag[]

  @@index([organizationId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([lifecycleStage])
  @@index([ownerMembershipId])
  @@index([archived])
  @@index([updatedAt])
  @@map("contacts")
}

model Lead {
  id                 String    @id @default(cuid())
  firstName          String?
  lastName           String?
  name               String?
  companyName        String?
  email              String?
  phone              String?
  source             String?
  status             String    @default("New")
  score              Int?      @default(0)
  priority           String?   @default("Medium")
  campaignId         String?
  campaign           Campaign? @relation(fields: [campaignId], references: [id])
  ownerId            String?
  owner              User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedContactId String?
  convertedCompanyId String?
  convertedDealId    String?
  tasks              Json      @default("[]")
  notes              Json      @default("[]")
  activityLog        Json      @default("[]")
  files              Json      @default("[]")
  auditLog           Json      @default("[]")
  archived           Boolean   @default(false)
  archiveReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // --- Backend Phase 2 additions ---
  organizationId          String?
  organization            Organization?           @relation("OrganizationLeads", fields: [organizationId], references: [id], onDelete: Cascade)
  displayName             String?
  normalizedEmail         String?
  normalizedPhone         String?
  country                 String?
  region                  String?
  city                    String?
  lifecycleStage          String?
  qualificationStatus     String?
  team                    String?
  department              String?
  estimatedValue          Float?
  currency                String?
  nextActionText          String?
  nextActionDate          DateTime?
  lastContactDate         DateTime?
  doNotContact            Boolean                 @default(false)
  // Frontend Lead form fields with no prior column (frontend-to-backend
  // Step 2). `description` holds the form's free-text "Notes" field — the
  // legacy `notes` column above is a Json array, not free text.
  jobTitle                String?
  preferredContactChannel String?
  interestedProduct       String?
  consent                 Boolean                 @default(true)
  disqualifyReason        String?
  description             String?
  ownerMembershipId       String?
  ownerMembership         OrganizationMembership? @relation("OwnedLeads", fields: [ownerMembershipId], references: [id])
  convertedAt             DateTime?
  convertedByMembershipId String?
  createdByMembershipId   String?
  updatedByMembershipId   String?
  archivedAt              DateTime?
  archivedByMembershipId  String?
  version                 Int                     @default(1)

  activities Activity[]
  crmNotes   CrmNote[]
  crmTags    CrmRecordTag[]

  @@index([organizationId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([status])
  @@index([lifecycleStage])
  @@index([ownerMembershipId])
  @@index([archived])
  @@index([updatedAt])
  @@map("leads")
}

model Deal {
  id                   String    @id @default(cuid())
  name                 String
  pipeline             String?
  stage                String
  status               String    @default("Open")
  dealType             String?
  source               String?
  companyId            String?
  company              Company?  @relation(fields: [companyId], references: [id])
  primaryContactId     String?
  primaryContact       Contact?  @relation(fields: [primaryContactId], references: [id])
  additionalContactIds Json      @default("[]")
  contactRoles         Json      @default("[]")
  ownerId              String?
  owner                User?     @relation("DealOwner", fields: [ownerId], references: [id])
  assignedTeam         String?
  currency             String    @default("USD")
  value                Decimal   @default(0) @db.Decimal(14, 2)
  probability          Int?      @default(0)
  expectedClosingDate  DateTime?
  actualClosingDate    DateTime?
  billingFrequency     String?   @default("One-time")
  priority             String?   @default("Medium")
  dealHealth           String?   @default("Healthy")
  healthReason         String?
  nextAction           String?
  competitors          Json      @default("[]")
  winReason            String?
  lossReason           String?
  cancelReason         String?
  holdReason           String?
  archived             Boolean   @default(false)
  archiveReason        String?
  notes                Json      @default("[]")
  activityLog          Json      @default("[]")
  files                Json      @default("[]")
  auditLog             Json      @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lineItems  DealLineItem[]
  activities Activity[]
  quotes     Quote[]
  orders     Order[]
  contracts  Contract[]
  projects   Project[]
  invoices   Invoice[]

  // --- Backend Phase 3 additions ---
  organizationId           String?
  organization             Organization?           @relation("OrganizationDeals", fields: [organizationId], references: [id], onDelete: Cascade)
  dealNumber               String?
  pipelineId               String?
  pipelineRef              Pipeline?               @relation(fields: [pipelineId], references: [id])
  pipelineStageId          String?
  pipelineStage            PipelineStage?          @relation(fields: [pipelineStageId], references: [id])
  forecastCategory         String?
  tags                     Json                    @default("[]")
  internalNote             String?
  lossCompetitor           String?
  onHoldReviewDate         DateTime?
  handoffOwnerMembershipId String?
  ownerMembershipId        String?
  ownerMembership          OrganizationMembership? @relation("OwnedDeals", fields: [ownerMembershipId], references: [id])
  createdByMembershipId    String?
  updatedByMembershipId    String?
  archivedByMembershipId   String?
  archivedAt               DateTime?
  // Free-text description from the Deal form (frontend-to-backend Step 5a).
  description              String?
  version                  Int                     @default(1)

  stageHistory DealStageHistory[]
  crmNotes     CrmNote[]
  crmTags      CrmRecordTag[]

  @@unique([organizationId, dealNumber])
  @@index([organizationId])
  @@index([pipelineId])
  @@index([pipelineStageId])
  @@index([ownerMembershipId])
  @@map("deals")
}

model DealLineItem {
  id               String       @id @default(cuid())
  dealId           String
  deal             Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  catalogItemId    String?
  catalogItem      CatalogItem? @relation(fields: [catalogItemId], references: [id])
  priceBookId      String?
  priceBookEntryId String?
  quantity         Float        @default(1)
  unitPrice        Decimal      @default(0) @db.Decimal(14, 2)
  discountType     String?
  discountValue    Decimal?     @db.Decimal(14, 2)
  taxCategory      String?      @default("Standard")
  order            Int          @default(0)

  // --- Backend Phase 3 additions ---
  nameSnapshot        String?
  descriptionSnapshot String?
  skuSnapshot         String?
  unitSnapshot        String?
  lineSubtotal        Decimal? @db.Decimal(14, 2)
  taxAmount           Decimal? @db.Decimal(14, 2)
  lineTotal           Decimal? @db.Decimal(14, 2)
  // Recurrence shown on the Deal products tab (frontend-to-backend Step 5a).
  billingFrequency    String?
  displayOrder        Int      @default(0)
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("deal_line_items")
}

model Activity {
  id           String    @id @default(cuid())
  title        String
  type         String    @default("Task")
  description  String?
  status       String    @default("Scheduled")
  priority     String?   @default("Medium")
  ownerId      String?
  owner        User?     @relation("ActivityOwner", fields: [ownerId], references: [id])
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id])
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id])
  startAt      DateTime?
  endAt        DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  attachments  Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // --- Backend Phase 2 additions ---
  // Lead relation is new — the pre-Phase-2 model had no way to link an
  // Activity to a Lead at all.
  organizationId          String?
  organization            Organization?           @relation("OrganizationActivities", fields: [organizationId], references: [id], onDelete: Cascade)
  leadId                  String?
  lead                    Lead?                   @relation(fields: [leadId], references: [id])
  // Backend Phase 3 — the legacy dealId/deal fields above (declared before
  // Phase 2) already give Activities a Deal relation; same-organization
  // enforcement is added in the Phase 3 activitiesController, matching the
  // leadId same-org check Phase 2 added.
  outcome                 String?
  scheduledStart          DateTime?
  scheduledEnd            DateTime?
  followUpRequired        Boolean                 @default(false)
  followUpDate            DateTime?
  followUpActivityId      String?
  followUpActivity        Activity?               @relation("ActivityFollowUp", fields: [followUpActivityId], references: [id])
  followUpOf              Activity[]              @relation("ActivityFollowUp")
  source                  String?
  ownerMembershipId       String?
  ownerMembership         OrganizationMembership? @relation("OwnedActivities", fields: [ownerMembershipId], references: [id])
  assignedMembershipId    String?
  assignedMembership      OrganizationMembership? @relation("AssignedActivities", fields: [assignedMembershipId], references: [id])
  createdByMembershipId   String?
  updatedByMembershipId   String?
  archivedAt              DateTime?
  // Frontend Activity form fields with no prior column (frontend-to-backend
  // Step 4) — per-type details for calls, emails and meetings.
  team                    String?
  participants            Json                    @default("[]")
  timeZone                String?
  reminder                String?
  completionNote          String?
  phone                   String?
  callDirection           String?
  callPurpose             String?
  expectedDurationMinutes Int?
  emailDirection          String?
  subject                 String?
  location                String?
  agenda                  String?
  visibility              String?
  version                 Int                     @default(1)

  crmNotes CrmNote[]
  crmTags  CrmRecordTag[]

  @@index([organizationId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@index([scheduledStart])
  @@index([ownerMembershipId])
  @@index([assignedMembershipId])
  @@index([updatedAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Backend Phase 2 — CRM Core Data Persistence: notes, tags, company-contact
// relationships, and merge history. Notes/tags use four nullable record FKs
// (exactly one set, enforced at the application layer) rather than a
// generic recordType+recordId polymorphic column — real FK constraints give
// referential integrity and let a join enforce organization-consistency,
// which a string-typed polymorphic column cannot; it also means no query
// ever constructs a table name from user input.
// ---------------------------------------------------------------------------
model CrmNote {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorMembershipId String
  authorMembership   OrganizationMembership @relation(fields: [authorMembershipId], references: [id])
  body               String
  pinned             Boolean                @default(false)
  edited             Boolean                @default(false)
  archivedAt         DateTime?
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([activityId])
  @@index([dealId])
  @@map("crm_notes")
}

model CrmTag {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  normalizedName        String
  colorToken            String?
  createdByMembershipId String?
  archivedAt            DateTime?
  createdAt             DateTime     @default(now())

  records CrmRecordTag[]

  // Tag names are unique within an organization after normalization —
  // never shared implicitly between organizations.
  @@unique([organizationId, normalizedName])
  @@map("crm_tags")
}

model CrmRecordTag {
  id        String   @id @default(cuid())
  tagId     String
  tag       CrmTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([tagId, leadId])
  @@unique([tagId, contactId])
  @@unique([tagId, companyId])
  @@unique([tagId, activityId])
  @@unique([tagId, dealId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([activityId])
  @@index([dealId])
  @@map("crm_record_tags")
}

// Many-to-many Company<->Contact with relationship metadata — a Contact may
// belong to more than one Company; a Company may have at most one ACTIVE
// primary Contact (enforced by the partial unique index below).
model CompanyContactRelationship {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relationshipType  String?
  jobTitleAtCompany String?
  isDecisionMaker   Boolean   @default(false)
  isPrimaryContact  Boolean   @default(false)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, contactId])
  @@index([companyId])
  @@index([contactId])
  @@map("company_contact_relationships")
}

// Append-only merge history — the record of every controlled merge, never
// itself editable or deletable through any API.
model RecordMerge {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordType              String // "Contact" | "Company"
  sourceRecordId          String
  destinationRecordId     String
  performedByMembershipId String
  reason                  String
  fieldResolutions        Json         @default("{}")
  createdAt               DateTime     @default(now())

  @@index([organizationId])
  @@index([destinationRecordId])
  @@map("record_merges")
}

// ---------------------------------------------------------------------------
// Sales: Catalog / Price Books / Quotes / Orders / Contracts
// ---------------------------------------------------------------------------
model CatalogItem {
  id                        String    @id @default(cuid())
  name                      String
  sku                       String?
  type                      String    @default("Product") // Product | Service | Package | Add-on
  category                  String?
  shortDescription          String?
  description               String?
  status                    String    @default("Draft")
  billingModel              String    @default("One Time")
  billingInterval           String?
  unit                      String    @default("Each")
  standardPrice             Decimal   @default(0) @db.Decimal(14, 2)
  currency                  String    @default("USD")
  alternativePrices         Json      @default("[]")
  costPreview               Decimal?  @db.Decimal(14, 2)
  taxCategory               String    @default("Standard")
  discountEligible          Boolean   @default(true)
  minQuantity               Int?
  maxQuantity               Int?
  effectiveDate             DateTime?
  expirationDate            DateTime?
  ownerId                   String?
  owner                     User?     @relation("CatalogItemOwner", fields: [ownerId], references: [id])
  tags                      Json      @default("[]")
  includedItems             Json      @default("[]")
  optionalAddOnIds          Json      @default("[]")
  compatibleParentIds       Json      @default("[]")
  termsSummary              String?
  internalNotes             String?
  customerFacingDescription String?
  usageConfig               Json?
  recurringConfig           Json?
  tieredPricing             Json      @default("[]")
  promotionalPrice          Decimal?  @db.Decimal(14, 2)
  promotionalUntil          DateTime?
  upcomingPriceChange       Json?
  archived                  Boolean   @default(false)
  archiveReason             String?
  archivedAt                DateTime?
  statusBeforeArchive       String?
  files                     Json      @default("[]")
  activityLog               Json      @default("[]")
  auditLog                  Json      @default("[]")
  createdBy                 String?
  updatedBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  dealLineItems     DealLineItem[]
  priceBookEntries  PriceBookEntry[]
  quoteLineItems    QuoteLineItem[]
  orderLineItems    OrderLineItem[]
  contractLineItems ContractLineItem[]

  // --- Backend Phase 3 additions ---
  organizationId        String?
  organization          Organization?           @relation("OrganizationCatalogItems", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId     String?
  ownerMembership       OrganizationMembership? @relation("OwnedCatalogItems", fields: [ownerMembershipId], references: [id])
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int                     @default(1)

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("catalog_items")
}

model PriceBook {
