// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------
// Backend Phase 6 — every money column is numeric (Decimal), computed only
// by services/sales/moneyService.js. Numbers are unique per organization
// (INV-/CN-/EXP- from SalesDocumentCounter). The free-text approvedBy /
// reviewedBy / submittedById columns are pre-Phase-6 and no longer written.
model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  // Line snapshots: [{ name, qty, unitPrice, taxCategory, lineSubtotal, taxAmount, lineTotal }]
  items          Json      @default("[]")
  currency       String    @default("USD")
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(14, 2)
  amountCredited Decimal   @default(0) @db.Decimal(14, 2)
  amountDue      Decimal   @default(0) @db.Decimal(14, 2)
  // Draft | Approved | Sent | Partially Paid | Paid | Void — "Overdue" is
  // derived from dueDate when read, never stored.
  status         String    @default("Draft")
  approvedBy     String?
  voidReason     String?
  issueDate      DateTime  @default(now())
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId         String?
  organization           Organization?           @relation("OrganizationInvoices", fields: [organizationId], references: [id], onDelete: Cascade)
  source                 String                  @default("Manual") // Manual | Order | Recurring
  recurringInvoiceId     String?
  recurringInvoice       RecurringInvoice?       @relation(fields: [recurringInvoiceId], references: [id])
  createdByMembershipId  String?
  createdByMembership    OrganizationMembership? @relation("CreatedInvoices", fields: [createdByMembershipId], references: [id])
  updatedByMembershipId  String?
  approvedByMembershipId String?
  approvedAt             DateTime?
  sentAt                 DateTime?
  paidAt                 DateTime?
  voidedAt               DateTime?
  voidedByMembershipId   String?
  version                Int                     @default(1)

  // Backend Phase 6 (full spec)
  contactId               String?
  contractId              String?
  projectId               String?
  exchangeRate            Decimal   @default(1) @db.Decimal(20, 10)
  paymentTermsDays        Int?
  billingAddress          Json?
  discountTotal           Decimal   @default(0) @db.Decimal(14, 2)
  submittedByMembershipId String?
  submittedAt             DateTime?
  postedByMembershipId    String?
  postedAt                DateTime?
  journalEntryId          String?
  disputeReason           String?
  writtenOffAt            DateTime?
  archivedAt              DateTime?

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([orderId])
  @@index([companyId])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  // Legacy direct link (Phase 6 first cut); allocations are authoritative.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  method    String   @default("Bank Transfer")
  date      DateTime @default(now())

  organizationId         String?
  reference              String?
  note                   String?
  recordedByMembershipId String?
  createdAt              DateTime @default(now())

  // Backend Phase 6 (full spec) — "Recorded payment — no bank or payment-provider transfer was performed."
  paymentNumber          String?
  // Incoming | Outgoing
  direction              String              @default("Incoming")
  financialAccountId     String?
  companyId              String?
  vendorId               String?
  currency               String              @default("USD")
  exchangeRate           Decimal             @default(1) @db.Decimal(20, 10)
  // Draft | Submitted | Approved | Posted | Reversed | Cancelled; Legacy Recorded = before the ledger
  status                 String              @default("Draft")
  createdByMembershipId  String?
  approvedByMembershipId String?
  approvedAt             DateTime?
  postedByMembershipId   String?
  postedAt               DateTime?
  journalEntryId         String?
  reversalJournalId      String?
  reversedAt             DateTime?
  reversalReason         String?
  cancelledReason        String?
  version                Int                 @default(1)
  updatedAt              DateTime            @default(now()) @updatedAt
  allocations            PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("payments")
}

model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  companyName      String?
  amount           Decimal  @db.Decimal(14, 2)
  reason           String?
  createdAt        DateTime @default(now())

  organizationId       String?
  currency             String  @default("USD")
  issuedByMembershipId String?

  // Backend Phase 6 (full spec)
  companyId              String?
  creditDate             DateTime  @default(now())
  // Draft | Submitted | Approved | Posted | Cancelled; Legacy Recorded = before the ledger
  status                 String    @default("Draft")
  lines                  Json      @default("[]")
  subtotal               Decimal   @default(0) @db.Decimal(14, 2)
  taxAdjustment          Decimal   @default(0) @db.Decimal(14, 2)
  exceptionReason        String?
  createdByMembershipId  String?
  approvedByMembershipId String?
  approvedAt             DateTime?
  postedByMembershipId   String?
  postedAt               DateTime?
  journalEntryId         String?
  appliedAmount          Decimal   @default(0) @db.Decimal(14, 2)
  remainingAmount        Decimal   @default(0) @db.Decimal(14, 2)
  version                Int       @default(1)
  updatedAt              DateTime  @default(now()) @updatedAt

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String
  description   String?
  category      String   @default("Other")
  amount        Decimal  @db.Decimal(14, 2)
  submittedById String?
  submittedBy   User?    @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  // Pending | Approved | Rejected
  status        String   @default("Pending")
  reviewedBy    String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  organizationId          String?
  organization            Organization?           @relation("OrganizationExpenses", fields: [organizationId], references: [id], onDelete: Cascade)
  currency                String                  @default("USD")
  submittedByMembershipId String?
  submittedByMembership   OrganizationMembership? @relation("SubmittedExpenses", fields: [submittedByMembershipId], references: [id])
  reviewedByMembershipId  String?
  reviewedAt              DateTime?
  reviewNote              String?
  updatedAt               DateTime                @default(now()) @updatedAt
  version                 Int                     @default(1)

  // Backend Phase 6 (full spec). amount = total incl. tax.
  merchant              String?
  vendorId              String?
  amountBeforeTax       Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal        @default(0) @db.Decimal(14, 2)
  taxRateId             String?
  taxSnapshot           Json?
  exchangeRate          Decimal        @default(1) @db.Decimal(20, 10)
  baseAmount            Decimal        @default(0) @db.Decimal(14, 2)
  expenseAccountId      String?
  costCenterId          String?
  projectId             String?
  billable              Boolean        @default(false)
  customerCompanyId     String?
  paymentMethod         String?
  policyException       Boolean        @default(false)
  policyExceptionReason String?
  expenseReportId       String?
  expenseReport         ExpenseReport? @relation(fields: [expenseReportId], references: [id])
  submittedAt           DateTime?
  rejectionReason       String?
  journalEntryId        String?
  // Metadata only — no file is stored.
  receiptMetadata       Json?
  archivedAt            DateTime?

  @@unique([organizationId, expenseNumber])
  @@index([organizationId])
  @@index([submittedByMembershipId])
  @@map("expenses")
}

model RecurringInvoice {
  id                String    @id @default(cuid())
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  items             Json      @default("[]")
  interval          String    @default("Monthly")
  active            Boolean   @default(true)
  lastGeneratedAt   DateTime?
  invoicesGenerated Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organizationId        String?
  organization          Organization? @relation("OrganizationRecurringInvoices", fields: [organizationId], references: [id], onDelete: Cascade)
  currency              String        @default("USD")
  dueDays               Int           @default(30)
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int           @default(1)

  invoices Invoice[]

  @@index([organizationId])
  @@map("recurring_invoices")
}

// Backend Phase 4 — a customer-visible reply ("Reply") or internal note
// ("Note") on a ticket, attributed to the member who wrote it.
model TicketMessage {
  id                 String   @id @default(cuid())
  ticketId           String
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId     String
  kind               String // Reply | Note (kept for the frontend; derived from messageType)
  body               String
  authorMembershipId String?
  createdAt          DateTime @default(now())

  // Full spec: who wrote it, what it is, who may see it, and honest delivery.
  // messageType: Customer Message | Agent Reply | Internal Note | System Event | Status Event
  messageType           String    @default("Agent Reply")
  // visibility: Customer Visible | Internal Only | Restricted Management
  visibility            String    @default("Customer Visible")
  authorType            String    @default("Agent") // Agent | Customer | System
  authorContactId       String?
  authorPortalAccountId String?
  sanitizedBody         String?
  source                String    @default("Agent Console") // Agent Console | Customer Portal | System
  // deliveryStatus: Not Applicable | Local Preview | Pending Provider | Delivered to Portal | Failed — never "Sent"
  deliveryStatus        String    @default("Not Applicable")
  editedAt              DateTime?
  archivedAt            DateTime?
  version               Int       @default(1)
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([ticketId])
  @@map("ticket_messages")
}

// Append-only ticket history. `snapshot` keeps the labels/values at the time
// (queue name, category name, policy version...) so later renames never
// rewrite history. `dedupeKey` makes worker-generated events idempotent.
model TicketEvent {
  id                   String   @id @default(cuid())
  organizationId       String
  ticketId             String
  ticket               Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventType            String
  actorType            String   @default("Agent") // Agent | Customer | System
  actorMembershipId    String?
  actorPortalAccountId String?
  fromValue            String?
  toValue              String?
  reason               String?
  snapshot             Json     @default("{}")
  // Internal-only events are never returned to the Customer Portal.
  customerVisible      Boolean  @default(false)
  dedupeKey            String?  @unique
  createdAt            DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([organizationId])
  @@map("ticket_events")
}

model SupportInbox {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  // Manual | Customer Portal | Internal | Email Placeholder | Chat Placeholder
  channelType           String    @default("Manual")
  defaultQueueId        String?
  active                Boolean   @default(true)
  customerDisplayName   String?
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  tickets Ticket[]

  @@unique([organizationId, name])
  @@map("support_inboxes")
}

model SupportQueue {
  id                       String    @id @default(cuid())
  organizationId           String
  name                     String
  description              String?
  department               String?
  team                     String?
  defaultSlaPolicyId       String?
  active                   Boolean   @default(true)
  // Manual | Round Robin
  assignmentMode           String    @default("Manual")
  // Round-robin cursor: the membership picked last time.
  lastAssignedMembershipId String?
  createdByMembershipId    String?
  updatedByMembershipId    String?
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  archivedAt               DateTime?

  members SupportQueueMember[]
  tickets Ticket[]

  @@unique([organizationId, name])
  @@map("support_queues")
}

model SupportQueueMember {
  id             String       @id @default(cuid())
  organizationId String
  queueId        String
  queue          SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  membershipId   String
  role           String       @default("Agent") // Agent | Lead | Manager
  active         Boolean      @default(true)
  // Max open tickets for round-robin; null = no limit.
  capacity       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([queueId, membershipId])
  @@index([membershipId])
  @@map("support_queue_members")
}

model TicketCategory {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  normalizedName  String
  description     String?
  parentId        String?
  parent          TicketCategory?  @relation("TicketCategoryTree", fields: [parentId], references: [id])
  children        TicketCategory[] @relation("TicketCategoryTree")
  active          Boolean          @default(true)
  displayOrder    Int              @default(0)
  defaultQueueId  String?
  defaultPriority String?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?

  tickets    Ticket[] @relation("TicketCategoryRef")
  subTickets Ticket[] @relation("TicketSubcategoryRef")

  @@unique([organizationId, parentId, normalizedName])
  @@map("ticket_categories")
}

model TicketFollower {
  id                  String   @id @default(cuid())
  organizationId      String
  ticketId            String
  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  membershipId        String
  addedByMembershipId String?
  createdAt           DateTime @default(now())

  @@unique([ticketId, membershipId])
  @@index([membershipId])
  @@map("ticket_followers")
}

// A customer's access to the portal — linked by an administrator to one
// Contact (and its Company). Never grants organization-member access.
model PortalAccount {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  user                  User      @relation("PortalAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  contactId             String
  companyId             String?
  // Invited | Active | Suspended
  status                String    @default("Invited")
  // Lets this contact see every ticket of their company, not just their own.
  companyWideAccess     Boolean   @default(false)
  invitedAt             DateTime  @default(now())
  activatedAt           DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  lastAccessAt          DateTime?
  createdByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tickets Ticket[]

  @@unique([organizationId, userId])
  @@unique([organizationId, contactId])
  @@map("portal_accounts")
}

// Business-hours calendar. workingHours: { "mon": [["09:00","17:00"]], ... }
// (local wall-clock times in `timeZone`); holidays: [{ "date": "2026-12-25", "name": "..." }].
model BusinessHoursCalendar {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  timeZone       String
  workingHours   Json
  holidays       Json      @default("[]")
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  active         Boolean   @default(true)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, name])
  @@map("business_hours_calendars")
}

// Stable identity of an SLA policy; the rules live in immutable versions.
model SlaPolicy {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  active                Boolean   @default(true)
  currentVersionId      String?
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  versions SlaPolicyVersion[]

  @@unique([organizationId, name])
  @@map("sla_policies")
}

// targets: { "Urgent": { "firstResponseMinutes": 60, "nextResponseMinutes": 120, "resolutionMinutes": 240 }, ... }
// Units are always minutes; businessHours says whether they count only
// calendar working time. calendarSnapshot freezes the calendar used.
model SlaPolicyVersion {
  id                    String    @id @default(cuid())
  organizationId        String
  policyId              String
  policy                SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber         Int
  businessHours         Boolean   @default(false)
  calendarId            String?
  calendarSnapshot      Json?
  timeZone              String    @default("UTC")
  targets               Json
  // Statuses that pause the resolution clock.
  pauseStatuses         Json      @default("[\"Waiting for Customer\"]")
  // Percent of the target elapsed at which a warning is raised.
  warningPercent        Int       @default(80)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdByMembershipId String?
  createdAt             DateTime  @default(now())

  tickets      Ticket[]
  entitlements SupportEntitlement[]

  @@unique([policyId, versionNumber])
  @@map("sla_policy_versions")
}

model SlaClock {
  id               String    @id @default(cuid())
  organizationId   String
  ticketId         String
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policyVersionId  String?
  // First Response | Next Response | Resolution
  targetType       String
  targetMinutes    Int
  businessHours    Boolean   @default(false)
  calendarSnapshot Json?
  startedAt        DateTime
  dueAt            DateTime
  pausedAt         DateTime?
  pausedMinutes    Int       @default(0)
  completedAt      DateTime?
  breachedAt       DateTime?
  warnedAt         DateTime?
  // When the warning threshold is reached (recomputed on pause/resume/priority change).
  warnAt           DateTime?
  // Running | Paused | Met | Breached | Cancelled
  state            String    @default("Running")
  lastCalculatedAt DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, state, dueAt])
  @@index([ticketId])
  @@map("sla_clocks")
}

model SupportEntitlement {
  id                    String            @id @default(cuid())
  organizationId        String
  companyId             String
  contractId            String?
  name                  String
  description           String?
  slaPolicyVersionId    String?
  slaPolicyVersion      SlaPolicyVersion? @relation(fields: [slaPolicyVersionId], references: [id])
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  supportLevel          String            @default("Standard")
  allowedChannels       Json              @default("[]")
  active                Boolean           @default(true)
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tickets Ticket[]

  @@index([organizationId, companyId])
  @@map("support_entitlements")
}

model CannedResponse {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  body                  String
  // Team | Personal
  visibility            String    @default("Team")
  queueId               String?
  categoryId            String?
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  @@index([organizationId])
  @@map("canned_responses")
}

model KbCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  // Internal | Customers
  visibility     String    @default("Internal")
  displayOrder   Int       @default(0)
  active         Boolean   @default(true)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  articles KbArticle[]

  @@unique([organizationId, slug])
  @@map("kb_categories")
}

model KbArticle {
  id                   String      @id @default(cuid())
  organizationId       String
  articleNumber        String
  categoryId           String?
  category             KbCategory? @relation(fields: [categoryId], references: [id])
  title                String
  slug                 String
  summary              String?
  // The published version (null until first publication).
  currentVersionId     String?
  // Draft | In Review | Approved | Published | Archived
  status               String      @default("Draft")
  // Internal | Customers
  visibility           String      @default("Internal")
  authorMembershipId   String?
  reviewerMembershipId String?
  publishedAt          DateTime?
  archivedAt           DateTime?
  viewCount            Int         @default(0)
  version              Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  versions KbArticleVersion[]

  @@unique([organizationId, slug])
  @@unique([organizationId, articleNumber])
  @@map("kb_articles")
}

model KbArticleVersion {
  id                      String    @id @default(cuid())
  organizationId          String
  articleId               String
  article                 KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber           Int
  title                   String
  summary                 String?
  body                    String
  changeNote              String?
  authorMembershipId      String?
  // Draft | In Review | Approved | Rejected | Published | Superseded
  reviewStatus            String    @default("Draft")
  reviewerMembershipId    String?
  reviewedAt              DateTime?
  reviewReason            String?
  publishedAt             DateTime?
  publishedByMembershipId String?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([articleId, versionNumber])
  @@map("kb_article_versions")
}

// Customer satisfaction — only ever submitted by the customer through the
// portal, once per ticket and requester.
model TicketSatisfaction {
  id              String   @id @default(cuid())
  organizationId  String
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  portalAccountId String
  contactId       String
  rating          Int
  comment         String?
  // Valid | Withdrawn
  status          String   @default("Valid")
  // None | Hidden
  moderationState String   @default("None")
  submittedAt     DateTime @default(now())

  @@unique([ticketId, portalAccountId])
  @@index([organizationId])
  @@map("ticket_satisfaction")
}

// Backend Phase 4 — append-only history of department escalations.
model TicketEscalation {
  id                      String   @id @default(cuid())
  ticketId                String
  ticket                  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId          String
  fromDepartment          String?
  toDepartment            String
  reason                  String
  escalatedByMembershipId String?
  createdAt               DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_escalations")
}

// ---------------------------------------------------------------------------
// Backend Phase 6 (full spec) — Finance. Finance RECORDS transactions; it
// never moves money. The organization is the finance entity (the frontend
// has no multi-entity support). Amounts are Postgres numeric, calculated
// with Decimal in the app — never floats.
// ---------------------------------------------------------------------------

model FinanceSettings {
  id                       String   @id @default(cuid())
  organizationId           String   @unique
  baseCurrency             String   @default("USD")
  // Separation of duties can be relaxed per organization; an emergency
  // override always needs finance_overrides:use and a reason, and is
  // recorded in FinanceOverride for auditors.
  separationOfDuties       Boolean  @default(true)
  journalApprovalRequired  Boolean  @default(true)
  invoiceApprovalThreshold Decimal  @default(10000) @db.Decimal(18, 2)
  expensePolicyLimit       Decimal? @db.Decimal(18, 2)
  receivableAccountId      String?
  payableAccountId         String?
  revenueAccountId         String?
  expenseAccountId         String?
  taxPayableAccountId      String?
  taxRecoverableAccountId  String?
  employeePayableAccountId String?
  updatedByMembershipId    String?
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("finance_settings")
}

model FinanceOverride {
  id                String   @id @default(cuid())
  organizationId    String
  action            String
  targetType        String
  targetId          String
  rule              String
  reason            String
  actorMembershipId String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("finance_overrides")
}

model FiscalYear {
  id                    String         @id @default(cuid())
  organizationId        String
  name                  String
  startDate             DateTime
  endDate               DateTime
  // Open | Closed
  status                String         @default("Open")
  createdByMembershipId String?
  version               Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  periods               FiscalPeriod[]
  budgets               Budget[]

  @@unique([organizationId, name])
  @@index([organizationId, startDate])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id                       String         @id @default(cuid())
  organizationId           String
  fiscalYearId             String
  fiscalYear               FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  periodNumber             Int
  name                     String
  startDate                DateTime
  endDate                  DateTime
  // Open | Soft Closed | Closed | Reopened
  status                   String         @default("Open")
  // Soft close is the preparer's step; the final close must be someone else.
  softClosedByMembershipId String?
  softClosedAt             DateTime?
  closedByMembershipId     String?
  closedAt                 DateTime?
  reopenedByMembershipId   String?
  reopenedAt               DateTime?
  reopenReason             String?
  version                  Int            @default(1)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  journalEntries           JournalEntry[]

  @@unique([fiscalYearId, periodNumber])
  @@index([organizationId, startDate])
  @@map("fiscal_periods")
}

model LedgerAccount {
  id                    String          @id @default(cuid())
  organizationId        String
  code                  String
  name                  String
  description           String?
  // Asset | Liability | Equity | Revenue | Expense
  type                  String
  // Optional role: Receivable | Payable | Cash | Bank | Tax Payable | Tax Recoverable | Employee Payable
  subtype               String?
  parentId              String?
  parent                LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id])
  children              LedgerAccount[] @relation("LedgerAccountTree")
  // Debit | Credit
  normalBalance         String
  // Only this currency may be posted to the account (null = any).
  currency              String?
  // Header accounts (postingAllowed = false) group others and take no lines.
  postingAllowed        Boolean         @default(true)
  active                Boolean         @default(true)
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int             @default(1)
  archivedAt            DateTime?
  archiveReason         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  lines                 JournalLine[]
  budgetLines           BudgetLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("ledger_accounts")
}

model CostCenter {
  id                String       @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?
  parentId          String?
  parent            CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children          CostCenter[] @relation("CostCenterTree")
  department        String?
  projectId         String?
  ownerMembershipId String?
  active            Boolean      @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  version           Int          @default(1)
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, code])
  @@map("cost_centers")
}

model TaxRate {
  id                String    @id @default(cuid())
  organizationId    String
  name              String
  code              String
  // Basis points: 1200 = 12.00 %. Snapshotted onto every document line.
  rateBasisPoints   Int
  // Sales | Purchase | Both
  type              String    @default("Both")
  recoverable       Boolean   @default(false)
  inclusive         Boolean   @default(false)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  salesAccountId    String?
  purchaseAccountId String?
  active            Boolean   @default(true)
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, code])
  @@map("tax_rates")
}

// Manual only — no rate provider. 1 baseCurrency = rate × quoteCurrency.
model ExchangeRate {
  id                     String    @id @default(cuid())
  organizationId         String
  baseCurrency           String
  quoteCurrency          String
  rate                   Decimal   @db.Decimal(20, 10)
  effectiveDate          DateTime
  source                 String
  // Draft | Approved | Archived
  status                 String    @default("Draft")
  enteredByMembershipId  String?
  approvedByMembershipId String?
  approvedAt             DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([organizationId, baseCurrency, quoteCurrency, effectiveDate])
  @@map("exchange_rates")
}

model JournalEntry {
  id                      String        @id @default(cuid())
  organizationId          String
  entryNumber             String
  entryDate               DateTime
  periodId                String?
  period                  FiscalPeriod? @relation(fields: [periodId], references: [id])
  description             String
  // Manual | Opening Balance | Invoice | Credit Note | Expense Report | Bill | Payment | Reversal | Adjustment
  sourceType              String        @default("Manual")
  sourceId                String?
  reference               String?
  currency                String
  // Transaction currency → base currency, snapshotted at creation.
  exchangeRate            Decimal       @default(1) @db.Decimal(20, 10)
  exchangeRateId          String?
  // Draft | Submitted | Approved | Posted | Reversed | Cancelled
  status                  String        @default("Draft")
  totalDebit              Decimal       @default(0) @db.Decimal(18, 2)
  totalCredit             Decimal       @default(0) @db.Decimal(18, 2)
  createdByMembershipId   String?
  submittedByMembershipId String?
  submittedAt             DateTime?
  approvedByMembershipId  String?
  approvedAt              DateTime?
  postedByMembershipId    String?
  postedAt                DateTime?
  reversalOfId            String?       @unique
  reversalOf              JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy              JournalEntry? @relation("JournalReversal")
  reversedAt              DateTime?
  reversalReason          String?
  cancelledReason         String?
  version                 Int           @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  lines                   JournalLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, status, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(cuid())
  organizationId String
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNumber     Int
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  costCenterId   String?
  projectId      String?
  companyId      String?
  description    String?
  debit          Decimal       @default(0) @db.Decimal(18, 2)
  credit         Decimal       @default(0) @db.Decimal(18, 2)
  currency       String
  baseDebit      Decimal       @default(0) @db.Decimal(18, 2)
  baseCredit     Decimal       @default(0) @db.Decimal(18, 2)
  taxRateId      String?
  taxSnapshot    Json?

  @@index([journalEntryId])
  @@index([organizationId, accountId])
  @@map("journal_lines")
}

// A vendor profile on a Phase 2 Company — not a copy of it.
model Vendor {
  id                      String       @id @default(cuid())
  organizationId          String
  companyId               String
  company                 Company      @relation(fields: [companyId], references: [id])
  vendorCode              String
  paymentTermsDays        Int          @default(30)
  taxRateId               String?
  currency                String       @default("USD")
  defaultPayableAccountId String?
  defaultExpenseAccountId String?
  active                  Boolean      @default(true)
  notes                   String?
  version                 Int          @default(1)
  archivedAt              DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  bills                   VendorBill[]

  @@unique([organizationId, vendorCode])
  @@unique([organizationId, companyId])
  @@map("vendors")
}

model ExpenseReport {
  id                       String    @id @default(cuid())
  organizationId           String
  reportNumber             String
  submitterMembershipId    String
  title                    String
  periodStart              DateTime?
  periodEnd                DateTime?
  description              String?
  // Draft | Submitted | Under Review | Approved | Rejected | Posted | Reimbursed Record | Cancelled
  // "Reimbursed Record" means a reimbursement was RECORDED, not paid.
  status                   String    @default("Draft")
  // Per-currency totals, recalculated by the backend: { "USD": "120.00" }
  totals                   Json      @default("{}")
  submittedAt              DateTime?
  approvedByMembershipId   String?
  approvedAt               DateTime?
  rejectedByMembershipId   String?
  rejectedAt               DateTime?
  rejectionReason          String?
  postedByMembershipId     String?
  postedAt                 DateTime?
  journalEntryId           String?
  reimbursedByMembershipId String?
  reimbursedAt             DateTime?
  reimbursementReference   String?
  cancelledReason          String?
  version                  Int       @default(1)
  archivedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  expenses                 Expense[]

  @@unique([organizationId, reportNumber])
  @@index([organizationId, submitterMembershipId])
  @@map("expense_reports")
}

model VendorBill {
  id                      String              @id @default(cuid())
  organizationId          String
  billNumber              String
  vendorId                String
  vendor                  Vendor              @relation(fields: [vendorId], references: [id])
  vendorReference         String
  billDate                DateTime
  dueDate                 DateTime?
  currency                String
  exchangeRate            Decimal             @default(1) @db.Decimal(20, 10)
  paymentTermsDays        Int?
  // Draft | Submitted | Approved | Posted | Partially Paid | Paid | Disputed | Void ("Overdue" is derived)
  status                  String              @default("Draft")
  subtotal                Decimal             @default(0) @db.Decimal(18, 2)
  tax                     Decimal             @default(0) @db.Decimal(18, 2)
  total                   Decimal             @default(0) @db.Decimal(18, 2)
  amountPaid              Decimal             @default(0) @db.Decimal(18, 2)
  amountDue               Decimal             @default(0) @db.Decimal(18, 2)
  payableAccountId        String?
  costCenterId            String?
  projectId               String?
  description             String?
  createdByMembershipId   String?
  submittedByMembershipId String?
  submittedAt             DateTime?
  approvedByMembershipId  String?
  approvedAt              DateTime?
  postedByMembershipId    String?
  postedAt                DateTime?
  journalEntryId          String?
  disputeReason           String?
  voidReason              String?
  voidedAt                DateTime?
  version                 Int                 @default(1)
  archivedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  lines                   VendorBillLine[]
  allocations             PaymentAllocation[]

  @@unique([organizationId, billNumber])
  @@unique([organizationId, vendorId, vendorReference])
  @@index([organizationId, status])
  @@map("vendor_bills")
}

model VendorBillLine {
  id             String     @id @default(cuid())
  organizationId String
  billId         String
  bill           VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  lineNumber     Int
  description    String
  quantity       Decimal    @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal    @db.Decimal(18, 4)
  accountId      String
  costCenterId   String?
  projectId      String?
  taxRateId      String?
  taxSnapshot    Json?
  lineSubtotal   Decimal    @db.Decimal(18, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal    @db.Decimal(18, 2)

  @@index([billId])
  @@map("vendor_bill_lines")
}

// Immutable line snapshots — never repriced from the catalog.
model InvoiceLine {
  id               String  @id @default(cuid())
  organizationId   String
  invoiceId        String
  invoice          Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber       Int
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(18, 4)
  unitPrice        Decimal @db.Decimal(18, 4)
  discountAmount   Decimal @default(0) @db.Decimal(18, 2)
  taxRateId        String?
  taxSnapshot      Json?
  lineSubtotal     Decimal @db.Decimal(18, 2)
  taxAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal @db.Decimal(18, 2)
  revenueAccountId String?
  costCenterId     String?
  projectId        String?
  orderId          String?

  @@index([invoiceId])
  @@map("invoice_lines")
}

model FinancialAccount {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  // Cash | Bank | Clearing | Card | Other
  type                  String
  // Last digits only — never full numbers or credentials.
  maskedReference       String?
  currency              String
  ledgerAccountId       String
  openingJournalId      String?
  active                Boolean   @default(true)
  createdByMembershipId String?
  version               Int       @default(1)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([organizationId, name])
  @@map("financial_accounts")
}

model PaymentAllocation {
  id                    String      @id @default(cuid())
  organizationId        String
  paymentId             String
  payment               Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId             String?
  invoice               Invoice?    @relation(fields: [invoiceId], references: [id])
  billId                String?
  bill                  VendorBill? @relation(fields: [billId], references: [id])
  amount                Decimal     @db.Decimal(18, 2)
  allocationDate        DateTime    @default(now())
  createdByMembershipId String?
  // Active | Reversed
  status                String      @default("Active")
  reversedAt            DateTime?
  createdAt             DateTime    @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([billId])
  @@map("payment_allocations")
}

model StatementImport {
  id                     String          @id @default(cuid())
  organizationId         String
  financialAccountId     String
  periodStart            DateTime?
  periodEnd              DateTime?
  checksum               String
  fileName               String
  columnMapping          Json            @default("{}")
  importedByMembershipId String?
  // Imported
  status                 String          @default("Imported")
  lineCount              Int             @default(0)
  duplicateCount         Int             @default(0)
  createdAt              DateTime        @default(now())
  lines                  StatementLine[]

  @@unique([financialAccountId, checksum])
  @@map("statement_imports")
}

model StatementLine {
  id                   String                @id @default(cuid())
  organizationId       String
  importId             String
  import               StatementImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  financialAccountId   String
  rowNumber            Int
  transactionDate      DateTime
  valueDate            DateTime?
  description          String
  reference            String?
  // Debit (money out) | Credit (money in), as the statement shows it.
  direction            String
  amount               Decimal               @db.Decimal(18, 2)
  currency             String
  runningBalance       Decimal?              @db.Decimal(18, 2)
  fingerprint          String
  // Unmatched | Matched | Excluded
  reconciliationStatus String                @default("Unmatched")
  createdAt            DateTime              @default(now())
  matches              ReconciliationMatch[]

  @@unique([financialAccountId, fingerprint])
  @@index([organizationId, reconciliationStatus])
  @@map("statement_lines")
}

model ReconciliationSession {
  id                     String                @id @default(cuid())
  organizationId         String
  financialAccountId     String
  periodStart            DateTime
  periodEnd              DateTime
  openingBalance         Decimal               @db.Decimal(18, 2)
  closingBalance         Decimal               @db.Decimal(18, 2)
  statementBalance       Decimal               @default(0) @db.Decimal(18, 2)
  ledgerBalance          Decimal               @default(0) @db.Decimal(18, 2)
  difference             Decimal               @default(0) @db.Decimal(18, 2)
  // Open | Submitted | Completed | Cancelled
  status                 String                @default("Open")
  preparedByMembershipId String?
  submittedAt            DateTime?
  approvedByMembershipId String?
  completedAt            DateTime?
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  matches                ReconciliationMatch[]

  @@index([organizationId, financialAccountId])
  @@map("reconciliation_sessions")
}

model ReconciliationMatch {
  id                    String                @id @default(cuid())
  organizationId        String
  sessionId             String
  session               ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Rows of one split / many-to-one / one-to-many match share a group.
  groupId               String
  statementLineId       String
  statementLine         StatementLine         @relation(fields: [statementLineId], references: [id])
  journalLineId         String?
  paymentId             String?
  // Exact | Manual | Split | Adjustment
  matchType             String                @default("Manual")
  amount                Decimal               @db.Decimal(18, 2)
  reason                String?
  createdByMembershipId String?
  // Active | Reversed
  status                String                @default("Active")
  reversedAt            DateTime?
  createdAt             DateTime              @default(now())

  @@index([sessionId])
  @@index([statementLineId])
  @@map("reconciliation_matches")
}

model Budget {
  id                    String          @id @default(cuid())
  organizationId        String
  name                  String
  fiscalYearId          String
  fiscalYear            FiscalYear      @relation(fields: [fiscalYearId], references: [id])
  currency              String
  // Draft | Submitted | Approved | Active | Superseded | Archived (mirrors the latest version)
  status                String          @default("Draft")
  ownerMembershipId     String?
  department            String?
  currentVersionId      String?
  activeVersionId       String?
  createdByMembershipId String?
  version               Int             @default(1)
  archivedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  versions              BudgetVersion[]

  @@unique([organizationId, name, fiscalYearId])
  @@map("budgets")
}

model BudgetVersion {
  id                      String       @id @default(cuid())
  organizationId          String
  budgetId                String
  budget                  Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  versionNumber           Int
  // Draft | Submitted | Approved | Rejected | Active | Superseded
  status                  String       @default("Draft")
  notes                   String?
  total                   Decimal      @default(0) @db.Decimal(18, 2)
  createdByMembershipId   String?
  submittedAt             DateTime?
  approvedByMembershipId  String?
  approvedAt              DateTime?
  rejectionReason         String?
  activatedByMembershipId String?
  activatedAt             DateTime?
  createdAt               DateTime     @default(now())
  lines                   BudgetLine[]

  @@unique([budgetId, versionNumber])
  @@map("budget_versions")
}

model BudgetLine {
  id              String        @id @default(cuid())
  organizationId  String
  budgetVersionId String
  budgetVersion   BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  accountId       String
  account         LedgerAccount @relation(fields: [accountId], references: [id])
  costCenterId    String?
  department      String?
  projectId       String?
  periodId        String?
  plannedAmount   Decimal       @db.Decimal(18, 2)
  notes           String?

  @@index([budgetVersionId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------------------
// Backend Phase 8 — External integrations. Provider-neutral gateway: catalog,
// connections, encrypted credentials, OAuth state, policies, sync, mappings,
// conflicts, webhooks (in and out) and a fair background task queue.
// A connection is "Connected" only after authorization, encrypted storage,
// scope verification and an authenticated identity call — never because a
// catalog card exists.
// ---------------------------------------------------------------------------

model IntegrationProvider {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  category           String
  description        String
  icon               String?
  apiVersion         String?
  // OAuth2 | API Key | Webhook Only | None
  authType           String
  // ["User Connection","Organization Connection","Service Connection"]
  ownershipTypes     Json     @default("[]")
  // [{ key, name, entityType, crmModule, direction, requiredScopes, sensitive, requiresPhase? }]
  capabilities       Json     @default("[]")
  requiredScopes     Json     @default("[]")
  optionalScopes     Json     @default("[]")
  webhookSupport     Boolean  @default(false)
  incrementalSync    Boolean  @default(false)
  sandboxSupport     Boolean  @default(false)
  docsUrl            String?
  statusPageUrl      String?
  dataCategories     Json     @default("[]")
  sensitiveWarning   String?
  // Adapter | Catalog Only | Blocked
  availability       String   @default("Catalog Only")
  availabilityReason String?
  active             Boolean  @default(true)
  adapterVersion     String?
  // Public, non-secret protocol facts: OAuth endpoints, PKCE support,
  // webhook signature scheme, rate-limit notes.
  protocol           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("integration_providers")
}

// An OAuth client registration for a provider: system-wide (organizationId
// null, managed by the System Owner) or organization-managed. The client
// secret lives in IntegrationCredential, encrypted.
model IntegrationProviderApp {
  id                        String   @id @default(cuid())
  organizationId            String?
  providerKey               String
  clientId                  String
  clientSecretCredentialId  String?
  webhookSecretCredentialId String?
  // Sandbox | Production
  environment               String   @default("Sandbox")
  settings                  Json     @default("{}")
  active                    Boolean  @default(true)
  createdByMembershipId     String?
  version                   Int      @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([organizationId, providerKey])
  @@map("integration_provider_apps")
}

model IntegrationConnection {
  id                        String    @id @default(cuid())
  publicId                  String    @unique
  organizationId            String
  providerKey               String
  name                      String
  // User Connection | Organization Connection | Service Connection
  ownershipType             String
  connectedUserId           String?
  connectedMembershipId     String?
  // Live | Simulator — never mixed on one connection.
  mode                      String    @default("Live")
  externalAccountId         String?
  externalAccountLabel      String?
  externalTenantId          String?
  status                    String    @default("Ready to Connect")
  grantedScopes             Json      @default("[]")
  requestedScopes           Json      @default("[]")
  capabilityState           Json      @default("{}")
  credentialRef             String?
  connectedAt               DateTime?
  lastVerifiedAt            DateTime?
  lastScopeCheckAt          DateTime?
  lastSuccessfulSyncAt      DateTime?
  lastFailedSyncAt          DateTime?
  reauthorizationRequiredAt DateTime?
  pausedAt                  DateTime?
  revokedAt                 DateTime?
  disconnectedAt            DateTime?
  rateLimitedUntil          DateTime?
  circuitOpenUntil          DateTime?
  consecutiveFailures       Int       @default(0)
  lastErrorCode             String?
  lastErrorMessage          String?
  createdByMembershipId     String?
  updatedByMembershipId     String?
  version                   Int       @default(1)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([organizationId, providerKey])
  @@index([organizationId, status])
  @@map("integration_connections")
}

// AES-256-GCM. The master key is outside PostgreSQL; `keyVersion` names it.
// The AAD binds each ciphertext to its organization, owner and type, so a
// ciphertext can't be moved to another connection.
model IntegrationCredential {
  id             String    @id @default(cuid())
  organizationId String?
  connectionId   String?
  providerAppId  String?
  // access_token | refresh_token | client_secret | webhook_secret | signing_secret | api_key | private_key | pkce_verifier
  credentialType String
  ciphertext     String
  nonce          String
  authTag        String
  keyVersion     Int
  expiresAt      DateTime?
  // Active | Superseded | Revoked
  status         String    @default("Active")
  rotatedAt      DateTime?
  rotatedFromId  String?
  createdAt      DateTime  @default(now())

  @@index([connectionId, credentialType, status])
  @@index([providerAppId, credentialType, status])
  @@map("integration_credentials")
}

// Server-side OAuth state: only a hash of the state is stored; the PKCE
// verifier is encrypted. Single use, short expiry, bound to organization,
// user, provider, scopes and redirect target.
model IntegrationOAuthState {
  id                 String    @id @default(cuid())
  stateHash          String    @unique
  organizationId     String
  userId             String
  membershipId       String?
  providerKey        String
  connectionId       String?
  ownershipType      String
  mode               String
  requestedScopes    Json      @default("[]")
  verifierCiphertext String
  verifierNonce      String
  verifierTag        String
  keyVersion         Int
  nonceHash          String?
  redirectTarget     String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([expiresAt])
  @@map("integration_oauth_states")
}

model IntegrationPolicy {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  allowedProviders        Json     @default("[]")
  blockedProviders        Json     @default("[]")
  allowedOwnershipTypes   Json     @default("[\"User Connection\",\"Organization Connection\"]")
  allowedDataCategories   Json     @default("[]")
  allowedDirections       Json     @default("[\"Import Only\"]")
  restrictedFields        Json     @default("[]")
  providerRestrictions    Json     @default("{}")
  requireAdminApproval    Boolean  @default(true)
  defaultConflictPolicy   String   @default("Manual")
  maxSyncFrequencyMinutes Int      @default(15)
  rawPayloadRetentionDays Int      @default(7)
  enabled                 Boolean  @default(true)
  updatedByMembershipId   String?
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("integration_policies")
}

model IntegrationSyncConfiguration {
  id                            String    @id @default(cuid())
  organizationId                String
  connectionId                  String
  capability                    String
  entityType                    String
  // Import Only | Export Only | Two Way
  direction                     String    @default("Import Only")
  // CRM | Provider
  sourceOfTruth                 String    @default("CRM")
  filters                       Json      @default("{}")
  dateRangeStart                DateTime?
  dateRangeEnd                  DateTime?
  fieldMapping                  Json      @default("{}")
  // Manual | Keep CRM | Keep Provider
  conflictPolicy                String    @default("Manual")
  // No Deletions | Tombstone Only
  deletionPolicy                String    @default("No Deletions")
  scheduleMinutes               Int?
  enabled                       Boolean   @default(false)
  twoWayConfirmedAt             DateTime?
  twoWayConfirmedByMembershipId String?
  initialSyncCompletedAt        DateTime?
  createdByMembershipId         String?
  updatedByMembershipId         String?
  version                       Int       @default(1)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@unique([connectionId, capability, entityType])
  @@map("integration_sync_configurations")
}

model IntegrationSyncCheckpoint {
  id                   String    @id @default(cuid())
  organizationId       String
  connectionId         String
  syncConfigurationId  String    @unique
  capability           String
  entityType           String
  cursor               String?
  watermark            String?
  lastProcessedEventId String?
  lastSuccessAt        DateTime?
  checkpointVersion    Int       @default(0)
  expiredAt            DateTime?
  updatedAt            DateTime  @updatedAt

  @@map("integration_sync_checkpoints")
}

model IntegrationSyncRun {
  id                      String    @id @default(cuid())
  organizationId          String
  connectionId            String
  syncConfigurationId     String?
  capability              String
  // Preview | Sync
  kind                    String    @default("Sync")
  // Manual | Schedule | Webhook | Retry
  trigger                 String    @default("Manual")
  direction               String
  // Queued | Running | Awaiting Confirmation | Paused | Completed | Completed with Warnings | Failed | Cancelled | Rate Limited | Expired
  status                  String    @default("Queued")
  startedAt               DateTime?
  completedAt             DateTime?
  discovered              Int       @default(0)
  created                 Int       @default(0)
  updated                 Int       @default(0)
  skipped                 Int       @default(0)
  conflicts               Int       @default(0)
  failures                Int       @default(0)
  apiCalls                Int       @default(0)
  rateLimitState          Json?
  checkpointBefore        String?
  checkpointAfter         String?
  // Preview only: the redacted, bounded plan the person confirms.
  preview                 Json?
  previewExpiresAt        DateTime?
  confirmedAt             DateTime?
  confirmedByMembershipId String?
  initiatedByMembershipId String?
  correlationId           String
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([organizationId, connectionId, createdAt])
  @@map("integration_sync_runs")
}

model IntegrationRecordMapping {
  id                   String    @id @default(cuid())
  organizationId       String
  connectionId         String
  providerEntityType   String
  externalId           String
  externalVersion      String?
  crmEntityType        String
  crmRecordId          String?
  lastInboundChecksum  String?
  lastOutboundChecksum String?
  lastSyncedAt         DateTime?
  // Active | Conflict | Tombstoned | Disconnected
  syncState            String    @default("Active")
  // CRM | Provider — which side wrote last (loop prevention)
  lastWriteOrigin      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([connectionId, providerEntityType, externalId])
  @@index([organizationId, crmEntityType, crmRecordId])
  @@map("integration_record_mappings")
}

model IntegrationConflict {
  id                     String    @id @default(cuid())
  organizationId         String
  connectionId           String
  mappingId              String
  entityType             String
  crmRecordId            String?
  externalId             String
  fields                 Json      @default("[]")
  crmValues              Json      @default("{}")
  providerValues         Json      @default("{}")
  restrictedFields       Json      @default("[]")
  // Open | Resolved
  status                 String    @default("Open")
  // Keep CRM | Keep Provider | Merge Selected Fields | Skip | Disconnect Mapping
  resolution             String?
  selectedFields         Json?
  resolvedByMembershipId String?
  resolvedAt             DateTime?
  resolutionReason       String?
  detectedAt             DateTime  @default(now())
  snapshotExpiresAt      DateTime?

  @@index([organizationId, status])
  @@map("integration_conflicts")
}

model IntegrationWebhookSubscription {
  id                     String    @id @default(cuid())
  organizationId         String
  connectionId           String
  providerKey            String
  providerSubscriptionId String?
  capability             String
  // Random, unguessable path segment of the inbound URL.
  callbackId             String    @unique
  secretCredentialId     String?
  expiresAt              DateTime?
  renewAt                DateTime?
  // Active | Expired | Deleted | Error
  status                 String    @default("Active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("integration_webhook_subscriptions")
}

model IntegrationWebhookEvent {
  id                String    @id @default(cuid())
  organizationId    String
  connectionId      String
  subscriptionId    String
  providerKey       String
  providerEventId   String
  eventType         String
  signatureValid    Boolean
  receivedAt        DateTime  @default(now())
  providerTimestamp DateTime?
  payloadHash       String
  // Redacted after payloadExpiresAt.
  payload           Json?
  // Queued | Processing | Processed | Failed | Dead Letter | Ignored
  processingStatus  String    @default("Queued")
  attempts          Int       @default(0)
  processedAt       DateTime?
  safeErrorCode     String?
  payloadExpiresAt  DateTime?

  @@unique([subscriptionId, providerEventId])
  @@index([organizationId, processingStatus])
  @@map("integration_webhook_events")
}

model IntegrationOutboundEndpoint {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  url                   String
  eventTypes            Json      @default("[]")
  secretCredentialId    String?
  timeoutMs             Int       @default(5000)
  active                Boolean   @default(true)
  createdByMembershipId String?
  version               Int       @default(1)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId])
  @@map("integration_outbound_endpoints")
}

model IntegrationOutboundDelivery {
  id               String    @id @default(cuid())
  organizationId   String
  endpointId       String
  eventType        String
  // Idempotency: one delivery per endpoint per CRM event.
  eventId          String
  deliveryId       String    @unique
  attempt          Int       @default(0)
  requestedAt      DateTime?
  responseStatus   Int?
  durationMs       Int?
  // Pending | Succeeded | Failed | Dead Letter
  result           String    @default("Pending")
  nextRetryAt      DateTime?
  safeError        String?
  payload          Json?
  payloadExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  @@unique([endpointId, eventId])
  @@index([result, nextRetryAt])
  @@map("integration_outbound_deliveries")
}

// The fair background queue for integration work. The worker takes tasks
// round-robin across organizations and connections with per-connection
// and per-organization concurrency limits.
model IntegrationTask {
  id             String    @id @default(cuid())
  organizationId String
  connectionId   String?
  // sync | webhook_event | outbound_delivery | refresh | health | renew_subscription
  kind           String
  refId          String
  // Queued | Running | Done | Failed | Dead Letter | Cancelled
  status         String    @default("Queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastErrorCode  String?
  lastError      String?
  dedupeKey      String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([organizationId, status])
  @@map("integration_tasks")
}

model IntegrationUsage {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  day            DateTime
  apiCalls       Int      @default(0)
  rateLimitHits  Int      @default(0)
  errors         Int      @default(0)
  recordsIn      Int      @default(0)
  recordsOut     Int      @default(0)

  @@unique([connectionId, day])
  @@map("integration_usage")
}

model IntegrationLog {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String?
  // info | warning | error
  level          String   @default("info")
  event          String
  message        String
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("integration_logs")
}

// ============================================================================
// Backend Phase 9 — AI Gateway, Provider Billing, OpenAI/Claude Integration
// and Governed AI Actions. Organization-owned keys (encrypted in the Phase 8
// credential store as credentialType "ai_api_key"); usage, budgets and
// governed actions are CRM-owned. Plain string references, like Phase 8.
// ============================================================================

// Platform catalog of AI providers (seeded; not tenant data).
model AiProvider {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String
  authType           String
  // ["text", "structured", "tools", "streaming", "embeddings"]
  capabilities       Json     @default("[]")
  // Adapter | Catalog Only | Disabled
  availability       String
  availabilityReason String?
  dataRetentionNote  String?
  docsUrl            String?
  dataPolicyUrl      String?
  adapterVersion     String?
  // Off unless the System Owner enables it (e.g. OpenRouter).
  enabledByDefault   Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("ai_providers")
}

model AiProviderConnection {
  id                    String    @id @default(cuid())
  publicId              String    @unique
  organizationId        String
  providerKey           String
  name                  String
  // Live | Simulator — never mixed on one connection.
  mode                  String    @default("Live")
  // Not Configured | Configuration Incomplete | Ready to Verify | Connected | Connected with Warnings |
  // Verification Failed | Rate Limited | Budget Exhausted | Suspended by Policy | Disabled | Revoked | Error
  status                String    @default("Configuration Incomplete")
  keyHint               String?
  verifiedAt            DateTime?
  verifiedModels        Json      @default("[]")
  lastErrorCode         String?
  lastErrorMessage      String?
  rateLimitedUntil      DateTime?
  circuitOpenUntil      DateTime?
  consecutiveFailures   Int       @default(0)
  disabledAt            DateTime?
  revokedAt             DateTime?
  createdByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([organizationId, providerKey, mode])
  @@index([organizationId, status])
  @@map("ai_provider_connections")
}

// Platform model catalog. Organizations choose among these through aliases.
model AiModel {
  id              String   @id @default(cuid())
  providerKey     String
  modelId         String
  displayName     String
  capabilities    Json     @default("[]")
  contextWindow   Int?
  maxOutputTokens Int?
  // Active | Deprecated
  status          String   @default("Active")
  // Catalog | Verified
  source          String   @default("Catalog")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerKey, modelId])
  @@map("ai_models")
}

model AiModelAlias {
  id                    String   @id @default(cuid())
  organizationId        String
  // fast | balanced | deep | structured
  alias                 String
  providerKey           String
  modelId               String
  version               Int      @default(1)
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([organizationId, alias, providerKey])
  @@index([organizationId, alias])
  @@map("ai_model_aliases")
}

// Versioned price tables. organizationId null = platform default.
model AiPriceTable {
  id                    String   @id @default(cuid())
  organizationId        String?
  providerKey           String
  version               Int
  currency              String   @default("USD")
  // per_million_tokens
  unit                  String   @default("per_million_tokens")
  effectiveFrom         DateTime
  sourceNote            String
  // Draft | Active | Superseded
  status                String   @default("Active")
  createdByMembershipId String?
  createdAt             DateTime @default(now())

  @@unique([organizationId, providerKey, version])
  @@index([providerKey, status])
  @@map("ai_price_tables")
}

model AiPriceEntry {
  id               String   @id @default(cuid())
  priceTableId     String
  modelId          String
  inputPrice       Decimal  @db.Decimal(14, 6)
  outputPrice      Decimal  @db.Decimal(14, 6)
  cachedInputPrice Decimal? @db.Decimal(14, 6)

  @@unique([priceTableId, modelId])
  @@map("ai_price_entries")
}

// Organization settings for a use case (defaults live in code).
model AiUseCase {
  id                     String   @id @default(cuid())
  organizationId         String
  key                    String
  enabled                Boolean  @default(true)
  allowedAliases         Json     @default("[]")
  maxInputChars          Int
  maxOutputTokens        Int
  allowedClassifications Json     @default("[]")
  toolsAllowed           Boolean  @default(false)
  streamingAllowed       Boolean  @default(false)
  version                Int      @default(1)
  updatedByMembershipId  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([organizationId, key])
  @@map("ai_use_cases")
}

model AiRoutingPolicy {
  id                    String   @id @default(cuid())
  organizationId        String
  useCaseKey            String
  primaryProviderKey    String
  primaryAlias          String
  fallbackProviderKey   String?
  fallbackAlias         String?
  version               Int      @default(1)
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([organizationId, useCaseKey])
  @@map("ai_routing_policies")
}

model AiPolicy {
  id                        String   @id @default(cuid())
  organizationId            String   @unique
  enabled                   Boolean  @default(true)
  allowedProviders          Json     @default("[]")
  allowedUseCases           Json     @default("[]")
  // { providerKey: [classification, ...] }
  providerClassifications   Json     @default("{}")
  restrictedFields          Json     @default("[]")
  // Mask | Pseudonymize | Exclude
  personalData              String   @default("Mask")
  providerStorage           Boolean  @default(false)
  providerMemory            Boolean  @default(false)
  maxRequestsPerUserPerHour Int      @default(60)
  // { actionType: true } — approver required
  actionApprovals           Json     @default("{}")
  // { requestPayloadDays, draftHours, evaluationDays, feedbackDays, providerMetadataDays }
  retention                 Json     @default("{}")
  version                   Int      @default(1)
  updatedByMembershipId     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("ai_policies")
}

model AiRedactionRule {
  id                    String   @id @default(cuid())
  organizationId        String
  classification        String
  // Allow | Mask | Pseudonymize | Remove
  action                String
  reason                String?
  version               Int      @default(1)
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([organizationId, classification])
  @@map("ai_redaction_rules")
}

// Platform prompt templates; versions are immutable once published.
model AiPromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  useCaseKey  String
  description String
  createdAt   DateTime @default(now())

  @@map("ai_prompt_templates")
}

model AiPromptTemplateVersion {
  id           String    @id @default(cuid())
  templateId   String
  version      Int
  system       String
  userTemplate String
  outputSchema String?
  // Draft | Published | Retired
  status       String    @default("Published")
  checksum     String
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([templateId, version])
  @@map("ai_prompt_template_versions")
}

model AiRequest {
  id                      String    @id @default(cuid())
  organizationId          String
  userId                  String?
