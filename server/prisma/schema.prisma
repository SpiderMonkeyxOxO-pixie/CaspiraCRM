  contractValue            Decimal?                @db.Decimal(14, 2)
  conversionIdempotencyKey String?                 @unique
  version                  Int                     @default(1)

  obligations    ContractObligation[]
  renewalReviews ContractRenewalReview[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([sourceOrderId])
  @@map("contracts")
}

model ContractLineItem {
  id                     String       @id @default(cuid())
  contractId             String
  contract               Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  catalogItemId          String?
  catalogItem            CatalogItem? @relation(fields: [catalogItemId], references: [id])
  isCustomLine           Boolean      @default(false)
  name                   String
  description            String?
  unit                   String       @default("Each")
  billingModel           String       @default("One Time")
  billingInterval        String?
  quantity               Float        @default(1)
  listPriceSnapshot      Decimal?     @db.Decimal(14, 2)
  priceBookIdUsed        String?
  priceBookPriceSnapshot Decimal?     @db.Decimal(14, 2)
  unitPrice              Decimal      @default(0) @db.Decimal(14, 2)
  discountType           String?
  discountValue          Decimal?     @db.Decimal(14, 2)
  taxCategory            String       @default("Standard")
  order                  Int          @default(0)

  // --- Backend Phase 3 additions ---
  lineSubtotal Decimal? @db.Decimal(14, 2)
  taxAmount    Decimal? @db.Decimal(14, 2)
  lineTotal    Decimal? @db.Decimal(14, 2)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contract_line_items")
}

// ---------------------------------------------------------------------------
// Backend Phase 3 — Sales Pipeline, Deals, Catalog, Quotes, Orders, Contracts
// New models: Pipeline/PipelineStage (org-configurable, none existed before),
// DealStageHistory (append-only), SalesApproval (generic, focused approval
// model — no shared approval system exists anywhere else in this codebase),
// ContractObligation/ContractRenewalReview, SalesDocumentCounter (org+docType
// scoped, concurrency-safe sequential document numbers).
// ---------------------------------------------------------------------------

model Pipeline {
  id                    String       @id @default(cuid())
  publicId              String?      @unique
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  currencyPolicy        String? // e.g. "USD" default currency for Deals created in this Pipeline, or null (any)
  isDefault             Boolean      @default(false)
  active                Boolean      @default(true)
  wipLimits             Json? // e.g. { "Negotiation": 6 } — per-Stage-name WIP caps, frontend-only enforcement today
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  archivedAt            DateTime?

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId])
  @@map("sales_pipelines")
}

model PipelineStage {
  id             String    @id @default(cuid())
  publicId       String?   @unique
  organizationId String
  pipelineId     String
  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  displayOrder   Int       @default(0)
  // Open | Won | Lost | Cancelled | OnHold — superset of the spec's
  // suggested Open/Won/Lost, matching the frontend's real DEAL_STATUSES.
  classification String    @default("Open")
  probability    Int       @default(0) // 0-100, enforced in application code
  requiredFields Json      @default("[]")
  entryRules     Json      @default("[]")
  exitRules      Json      @default("[]")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  deals Deal[]

  @@index([organizationId])
  @@index([pipelineId])
  @@map("sales_pipeline_stages")
}

// Append-only — no route ever updates or deletes a row here. Snapshots the
// Stage names/probabilities AT THE TIME of the change so a later Stage rename
// or probability edit never rewrites historical meaning.
model DealStageHistory {
  id                         String   @id @default(cuid())
  dealId                     String
  deal                       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId             String?
  fromStageId                String?
  fromStageName              String?
  fromProbability            Int?
  toStageId                  String?
  toStageName                String?
  toProbability              Int?
  changedByMembershipId      String?
  changedAt                  DateTime @default(now())
  reason                     String?
  timeInPreviousStageSeconds Int?
  correlationId              String?

  @@index([dealId])
  @@index([organizationId])
  @@map("deal_stage_history")
}

model SalesApproval {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType             String // "Quote" this phase; generic enough to extend later
  resourceId               String
  quoteId                  String?
  quote                    Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedByMembershipId  String
  requiredPermissionOrRole String?
  reason                   String?
  snapshot                 Json         @default("{}")
  status                   String       @default("Pending") // Pending | Approved | Rejected
  decidedByMembershipId    String?
  decisionReason           String?
  requestedAt              DateTime     @default(now())
  decidedAt                DateTime?

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([quoteId])
  @@map("sales_approvals")
}

model ContractObligation {
  id                      String    @id @default(cuid())
  contractId              String
  contract                Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organizationId          String?
  title                   String
  description             String?
  ownerMembershipId       String?
  dueDate                 DateTime?
  status                  String    @default("Open") // Open | In Progress | Completed | Overdue | Waived | Cancelled
  completedDate           DateTime?
  completedByMembershipId String?
  waiveReason             String?
  evidenceNote            String?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([contractId])
  @@index([organizationId])
  @@map("contract_obligations")
}

model ContractRenewalReview {
  id                       String    @id @default(cuid())
  contractId               String
  contract                 Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  renewalOwnerMembershipId String?
  renewalNoticeDeadline    DateTime?
  proposedStartDate        DateTime?
  proposedEndDate          DateTime?
  proposedValue            Decimal?  @db.Decimal(14, 2)
  decision                 String? // Renew | Do Not Renew | Renegotiate
  decisionReason           String?
  decidedByMembershipId    String?
  decidedAt                DateTime?
  relatedNewContractId     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([contractId])
  @@map("contract_renewal_reviews")
}

model SalesDocumentCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        String // Deal | Quote | Order | Contract
  value          Int          @default(0)

  @@unique([organizationId, docType])
  @@map("sales_document_counters")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------
model Ticket {
  id                    String    @id @default(cuid())
  // Unique per organization (see @@unique below) — numbers come from the
  // per-organization document counter, so they repeat across organizations.
  ticketNumber          String
  companyId             String?
  company               Company?  @relation(fields: [companyId], references: [id])
  contactId             String?
  contact               Contact?  @relation(fields: [contactId], references: [id])
  subject               String
  description           String?
  source                String    @default("Portal")
  category              String    @default("General")
  priority              String    @default("Medium")
  department            String    @default("Support")
  assignedAgentId       String?
  assignedAgent         User?     @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  status                String    @default("New")
  slaResponseDeadline   DateTime?
  slaResolutionDeadline DateTime?
  firstRespondedAt      DateTime?
  publicReplies         Json      @default("[]")
  privateNotes          Json      @default("[]")
  escalations           Json      @default("[]")
  resolutionSummary     String?
  resolvedAt            DateTime?
  csatScore             Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // --- Backend Phase 4 (Support) additions ---
  // The Json reply/note/escalation columns above are legacy; replies,
  // notes and escalations now live in TicketMessage / TicketEscalation.
  organizationId        String?
  organization          Organization?           @relation("OrganizationTickets", fields: [organizationId], references: [id], onDelete: Cascade)
  assignedMembershipId  String?
  assignedMembership    OrganizationMembership? @relation("AssignedTickets", fields: [assignedMembershipId], references: [id])
  createdByMembershipId String?
  updatedByMembershipId String?
  closedAt              DateTime?
  version               Int                     @default(1)

  // --- Backend Phase 4, completed to the full spec (docs/specs/BACKEND_PHASE4_SPEC.md) ---
  inboxId                String?
  inbox                  SupportInbox?       @relation(fields: [inboxId], references: [id])
  queueId                String?
  queue                  SupportQueue?       @relation(fields: [queueId], references: [id])
  categoryId             String?
  categoryRef            TicketCategory?     @relation("TicketCategoryRef", fields: [categoryId], references: [id])
  subcategoryId          String?
  subcategoryRef         TicketCategory?     @relation("TicketSubcategoryRef", fields: [subcategoryId], references: [id])
  portalAccountId        String?
  portalAccount          PortalAccount?      @relation(fields: [portalAccountId], references: [id])
  ownerMembershipId      String?
  team                   String?
  relatedLeadId          String?
  relatedDealId          String?
  relatedOrderId         String?
  relatedContractId      String?
  entitlementId          String?
  entitlement            SupportEntitlement? @relation(fields: [entitlementId], references: [id])
  slaPolicyVersionId     String?
  slaPolicyVersion       SlaPolicyVersion?   @relation(fields: [slaPolicyVersionId], references: [id])
  reopenedAt             DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  waitingReason          String?
  resolutionCode         String?
  archivedAt             DateTime?
  archiveReason          String?
  archivedByMembershipId String?
  statusBeforeArchive    String?
  mergedIntoTicketId     String?
  normalizedSubject      String?

  messages         TicketMessage[]
  escalationEvents TicketEscalation[]
  events           TicketEvent[]
  followers        TicketFollower[]
  slaClocks        SlaClock[]
  satisfaction     TicketSatisfaction[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([assignedMembershipId])
  @@index([status])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------
model Project {
  id              String    @id @default(cuid())
  name            String
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  dealId          String?
  deal            Deal?     @relation(fields: [dealId], references: [id])
  status          String    @default("Planning")
  ownerId         String?
  owner           User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  startDate       DateTime?
  dueDate         DateTime?
  description     String?
  customerVisible Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  milestones Milestone[]
  tasks      Task[]

  // --- Backend Phase 5 (Projects) additions ---
  // ownerId (User) is legacy; ownership is by membership so scope checks
  // stay organization-consistent.
  organizationId        String?
  organization          Organization?           @relation("OrganizationProjects", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembershipId     String?
  ownerMembership       OrganizationMembership? @relation("OwnedProjects", fields: [ownerMembershipId], references: [id])
  createdByMembershipId String?
  updatedByMembershipId String?
  completedAt           DateTime?
  version               Int                     @default(1)

  // --- Backend Phase 5, completed to the full spec (docs/specs/BACKEND_PHASE5_SPEC.md) ---
  // ownerMembershipId is the Project Manager; startDate/dueDate are the
  // planned start/end.
  projectNumber          String?
  portfolioId            String?
  portfolio              ProjectPortfolio? @relation(fields: [portfolioId], references: [id])
  projectType            String            @default("Delivery")
  priority               String            @default("Medium")
  // On Track | At Risk | Off Track — set by a person with a note, never a computed score.
  healthState            String?
  healthNote             String?
  primaryContactId       String?
  sourceOrderId          String?
  sourceContractId       String?
  department             String?
  team                   String?
  actualStartDate        DateTime?
  actualEndDate          DateTime?
  plannedEffortMinutes   Int?
  currency               String?
  // Sensitive: only returned with projects:view_financial_fields.
  plannedBudget          Decimal?          @db.Decimal(14, 2)
  customerSummary        String?
  // Task Count | Weighted | Milestones | Manual
  progressMode           String            @default("Task Count")
  manualProgress         Int?
  manualProgressReason   String?
  templateId             String?
  templateVersionNumber  Int?
  cancelledAt            DateTime?
  cancellationReason     String?
  archivedAt             DateTime?
  archiveReason          String?
  archivedByMembershipId String?
  statusBeforeArchive    String?

  members         ProjectMember[]
  phases          ProjectPhase[]
  boards          TaskBoard[]
  dependencies    TaskDependency[]
  activities      ProjectActivity[]
  deliverables    Deliverable[]
  risks           ProjectRisk[]
  issues          ProjectIssue[]
  changeRequests  ChangeRequest[]
  baselines       ProjectBaseline[]
  projectComments TaskComment[]     @relation("ProjectComments")
  timeEntries     TaskTimeEntry[]   @relation("ProjectTimeEntries")

  @@unique([organizationId, projectNumber])
  @@index([organizationId])
  @@index([ownerMembershipId])
  @@map("projects")
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dueDate   DateTime?
  completed Boolean   @default(false)

  // Backend Phase 5
  completedAt             DateTime?
  completedByMembershipId String?
  createdAt               DateTime  @default(now())

  // Full spec. dueDate is the planned date; `completed` mirrors status Achieved.
  organizationId     String?
  phaseId            String?
  description        String?
  ownerMembershipId  String?
  // Planned | In Progress | At Risk | Achieved | Missed | Cancelled
  status             String    @default("Planned")
  customerVisible    Boolean   @default(false)
  acceptanceRequired Boolean   @default(false)
  version            Int       @default(1)
  updatedAt          DateTime  @default(now()) @updatedAt
  archivedAt         DateTime?

  deliverables Deliverable[]

  @@index([projectId])
  @@map("milestones")
}

model Task {
  id            String    @id @default(cuid())
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  assigneeId    String?
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  watchers      Json      @default("[]")
  priority      String    @default("Medium")
  status        String    @default("To Do")
  dueDate       DateTime?
  estimateHours Float?
  loggedHours   Float     @default(0)
  timeEntries   Json      @default("[]")
  dependsOnId   String?
  dependsOn     Task?     @relation("TaskDependency", fields: [dependsOnId], references: [id])
  blockedTasks  Task[]    @relation("TaskDependency")
  recurring     Boolean   @default(false)
  comments      Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Backend Phase 5 (Tasks) additions ---
  // assigneeId (User) and the Json comments/timeEntries columns are legacy;
  // comments and time now live in TaskComment / TaskTimeEntry, and
  // loggedHours is kept in step with the entries server-side.
  organizationId        String?
  organization          Organization?           @relation("OrganizationTasks", fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeMembershipId  String?
  assigneeMembership    OrganizationMembership? @relation("AssignedTasks", fields: [assigneeMembershipId], references: [id])
  createdByMembershipId String?
  updatedByMembershipId String?
  completedAt           DateTime?
  version               Int                     @default(1)

  commentEntries TaskComment[]
  timeLog        TaskTimeEntry[]

  // --- Backend Phase 5, full spec ---
  // status mirrors the board column's name (the frontend's To Do / In
  // Progress / Review / Done); statusCategory is that column's category.
  // assigneeMembershipId is the primary assignee; every assignee is in
  // TaskAssignee. estimateHours is kept in step with estimatedMinutes.
  taskNumber           String?
  parentTaskId         String?
  parentTask           Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks             Task[]       @relation("Subtasks")
  phaseId              String?
  milestoneId          String?
  boardId              String?
  columnId             String?
  column               BoardColumn? @relation(fields: [columnId], references: [id])
  taskType             String       @default("Task")
  statusCategory       String       @default("Backlog")
  ownerMembershipId    String?
  reporterMembershipId String?
  plannedStartDate     DateTime?
  actualStartDate      DateTime?
  estimatedMinutes     Int?
  remainingMinutes     Int?
  weight               Int          @default(1)
  progress             Int          @default(0)
  blocked              Boolean      @default(false)
  blockedReason        String?
  customerVisible      Boolean      @default(false)
  archivedAt           DateTime?
  archiveReason        String?

  assignees        TaskAssignee[]
  checklist        TaskChecklistItem[]
  labels           TaskLabel[]
  predecessorLinks TaskDependency[]    @relation("DependencySuccessor")
  successorLinks   TaskDependency[]    @relation("DependencyPredecessor")

  @@unique([organizationId, taskNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeMembershipId])
  @@map("tasks")
}

// Backend Phase 5 — a comment on a task, attributed to its author's membership.
model TaskComment {
  id                 String   @id @default(cuid())
  // Null for a project-level comment.
  taskId             String?
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organizationId     String
  body               String
  authorMembershipId String?
  createdAt          DateTime @default(now())

  // Full spec: project-level comments, visibility, edits, archive.
  projectId             String?
  project               Project?  @relation("ProjectComments", fields: [projectId], references: [id], onDelete: Cascade)
  // Project Team | Restricted Management | Customer Visible
  visibility            String    @default("Project Team")
  authorPortalAccountId String?
  editedAt              DateTime?
  archivedAt            DateTime?
  version               Int       @default(1)
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([taskId])
  @@index([projectId])
  @@map("task_comments")
}

// Backend Phase 5 — hours logged against a task (append-only).
model TaskTimeEntry {
  id                 String   @id @default(cuid())
  // Optional: time can be logged against the project itself.
  taskId             String?
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organizationId     String
  // Legacy hours; durationMinutes is authoritative.
  hours              Float?
  note               String?
  // The member the time belongs to.
  authorMembershipId String?
  createdAt          DateTime @default(now())

  // Full spec. status: Draft | Submitted | Approved | Rejected
  projectId              String?
  project                Project?  @relation("ProjectTimeEntries", fields: [projectId], references: [id])
  workDate               DateTime?
  startTime              DateTime?
  endTime                DateTime?
  durationMinutes        Int       @default(0)
  billable               Boolean   @default(false)
  status                 String    @default("Draft")
  submittedAt            DateTime?
  approvedByMembershipId String?
  approvedAt             DateTime?
  rejectedByMembershipId String?
  rejectedAt             DateTime?
  rejectionReason        String?
  // Manual | Timer | Correction
  source                 String    @default("Manual")
  // A correction of an approved entry points at the entry it adjusts.
  correctsEntryId        String?
  correctionReason       String?
  version                Int       @default(1)
  updatedAt              DateTime  @default(now()) @updatedAt
  archivedAt             DateTime?

  @@index([taskId])
  @@index([projectId])
  @@index([authorMembershipId, workDate])
  @@map("task_time_entries")
}

model ProjectPortfolio {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  ownerMembershipId     String?
  department            String?
  // Active | On Hold | Closed
  status                String    @default("Active")
  // Organization | Restricted
  visibility            String    @default("Organization")
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  projects Project[]

  @@unique([organizationId, name])
  @@map("project_portfolios")
}

model ProjectTemplate {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  projectType           String    @default("Delivery")
  active                Boolean   @default(true)
  currentVersionId      String?
  createdByMembershipId String?
  updatedByMembershipId String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  versions ProjectTemplateVersion[]

  @@unique([organizationId, name])
  @@map("project_templates")
}

// Immutable once created. content: { phases, columns, milestones, tasks,
// dependencies, roles } — see projectTemplateService.js.
model ProjectTemplateVersion {
  id                    String          @id @default(cuid())
  organizationId        String
  templateId            String
  template              ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber         Int
  content               Json
  changeNote            String?
  createdByMembershipId String?
  createdAt             DateTime        @default(now())

  @@unique([templateId, versionNumber])
  @@map("project_template_versions")
}

model ProjectMember {
  id                String    @id @default(cuid())
  organizationId    String
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId      String
  // Project Sponsor | Project Manager | Team Lead | Contributor | Reviewer | Observer
  role              String    @default("Contributor")
  // Edit | View
  accessLevel       String    @default("Edit")
  startDate         DateTime?
  endDate           DateTime?
  allocationPercent Int?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, membershipId])
  @@index([membershipId])
  @@map("project_members")
}

model ProjectPhase {
  id                String    @id @default(cuid())
  organizationId    String
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  displayOrder      Int       @default(0)
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  // Not Started | In Progress | Completed | Cancelled
  status            String    @default("Not Started")
  ownerMembershipId String?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  @@index([projectId])
  @@map("project_phases")
}

model TaskBoard {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  columns BoardColumn[]

  @@index([projectId])
  @@map("task_boards")
}

model BoardColumn {
  id                   String    @id @default(cuid())
  organizationId       String
  boardId              String
  board                TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  displayOrder         Int       @default(0)
  // Backlog | Ready | In Progress | Review | Blocked | Completed | Cancelled
  category             String    @default("Backlog")
  wipLimit             Int?
  isCompletion         Boolean   @default(false)
  active               Boolean   @default(true)
  // Task fields that must be set to enter, e.g. ["estimatedMinutes"].
  requiredFields       Json      @default("[]")
  // Column ids a task may come from; empty = any.
  allowedFromColumnIds Json      @default("[]")
  // Project roles allowed to move tasks in; empty = any member.
  allowedRoles         Json      @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tasks Task[]

  @@index([boardId])
  @@map("board_columns")
}

model TaskAssignee {
  id                     String    @id @default(cuid())
  organizationId         String
  taskId                 String
  task                   Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membershipId           String
  // Owner | Contributor | Reviewer
  role                   String    @default("Contributor")
  assignedByMembershipId String?
  assignedAt             DateTime  @default(now())
  removedAt              DateTime?

  @@index([taskId])
  @@index([membershipId])
  @@map("task_assignees")
}

model TaskChecklistItem {
  id                      String    @id @default(cuid())
  organizationId          String
  taskId                  String
  task                    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title                   String
  displayOrder            Int       @default(0)
  completed               Boolean   @default(false)
  completedByMembershipId String?
  completedAt             DateTime?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  archivedAt              DateTime?

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskDependency {
  id                    String   @id @default(cuid())
  organizationId        String
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorId         String
  predecessor           Task     @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId           String
  successor             Task     @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  // Finish to Start | Start to Start | Finish to Finish | Start to Finish
  type                  String   @default("Finish to Start")
  // Lag in minutes (negative = lead time).
  lagMinutes            Int      @default(0)
  createdByMembershipId String?
  createdAt             DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@map("task_dependencies")
}

model ProjectLabel {
  id             String    @id @default(cuid())
  organizationId String
  // Null = organization-wide label.
  projectId      String?
  name           String
  normalizedName String
  // A design-token name (e.g. "blue", "amber") — never raw CSS.
  colorToken     String    @default("gray")
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  tasks TaskLabel[]

  @@unique([organizationId, projectId, normalizedName])
  @@map("project_labels")
}

model TaskLabel {
  taskId  String
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

// Append-only project history. Snapshots keep historical meaning.
model ProjectActivity {
  id                   String   @id @default(cuid())
  organizationId       String
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId               String?
  eventType            String
  actorType            String   @default("Member") // Member | Customer | System
  actorMembershipId    String?
  actorPortalAccountId String?
  fromValue            String?
  toValue              String?
  reason               String?
  snapshot             Json     @default("{}")
  customerVisible      Boolean  @default(false)
  dedupeKey            String?  @unique
  createdAt            DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_activities")
}

// Server-timed work timer — Running | Paused | Stopped | Discarded.
model WorkTimer {
  id                 String    @id @default(cuid())
  organizationId     String
  membershipId       String
  projectId          String
  taskId             String?
  state              String    @default("Running")
  startedAt          DateTime  @default(now())
  lastResumedAt      DateTime? @default(now())
  pausedAt           DateTime?
  accumulatedSeconds Int       @default(0)
  stoppedAt          DateTime?
  timeEntryId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([membershipId, state])
  @@map("work_timers")
}

model Deliverable {
  id                   String     @id @default(cuid())
  organizationId       String
  deliverableNumber    String
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId          String?
  milestone            Milestone? @relation(fields: [milestoneId], references: [id])
  name                 String
  description          String?
  ownerMembershipId    String?
  reviewerMembershipId String?
  // Draft | In Progress | Ready for Review | Changes Requested | Approved Internally | Ready for Customer Review | Accepted | Rejected | Cancelled
  status               String     @default("Draft")
  dueDate              DateTime?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  customerVisible      Boolean    @default(false)
  acceptanceCriteria   String?
  currentVersionNumber Int        @default(1)
  version              Int        @default(1)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  archivedAt           DateTime?

  decisions DeliverableDecision[]

  @@unique([organizationId, deliverableNumber])
  @@index([projectId])
  @@map("deliverables")
}

// Append-only review/acceptance record. An acceptance is a recorded
// decision — not an electronic signature.
model DeliverableDecision {
  id                   String      @id @default(cuid())
  organizationId       String
  deliverableId        String
  deliverable          Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  versionNumber        Int
  // Submitted | Approved Internally | Changes Requested | Accepted | Rejected
  decision             String
  comment              String?
  // Internal | Customer
  actorType            String      @default("Internal")
  actorMembershipId    String?
  actorPortalAccountId String?
  customerVisible      Boolean     @default(false)
  createdAt            DateTime    @default(now())

  @@index([deliverableId])
  @@map("deliverable_decisions")
}

model ProjectRisk {
  id                     String    @id @default(cuid())
  organizationId         String
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  category               String    @default("Delivery")
  // Levels, not invented probabilities: Low | Medium | High | Very High
  probabilityLevel       String    @default("Medium")
  impactLevel            String    @default("Medium")
  priority               String    @default("Medium")
  ownerMembershipId      String?
  // Avoid | Mitigate | Transfer | Accept
  responseStrategy       String?
  mitigationPlan         String?
  trigger                String?
  // Identified | Assessing | Monitoring | Mitigating | Closed | Accepted
  status                 String    @default("Identified")
  internalOnly           Boolean   @default(true)
  reviewDate             DateTime?
  acceptanceReason       String?
  acceptedByMembershipId String?
  closedAt               DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([projectId])
  @@map("project_risks")
}

model ProjectIssue {
  id                   String    @id @default(cuid())
  organizationId       String
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relatedTaskId        String?
  // May link to a Support Ticket; the two histories stay separate.
  relatedTicketId      String?
  title                String
  description          String?
  priority             String    @default("Medium")
  // Minor | Moderate | Major | Critical
  severity             String    @default("Moderate")
  ownerMembershipId    String?
  // Open | Investigating | In Progress | Blocked | Resolved | Closed
  status               String    @default("Open")
  internalOnly         Boolean   @default(true)
  detectedAt           DateTime  @default(now())
  targetResolutionDate DateTime?
  resolvedAt           DateTime?
  resolutionSummary    String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId])
  @@map("project_issues")
}

model ChangeRequest {
  id                      String    @id @default(cuid())
  organizationId          String
  changeNumber            String
  projectId               String
  project                 Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedByMembershipId String?
  title                   String
  description             String?
  businessReason          String?
  scopeImpact             String?
  // { newPlannedEndDate?, tasks?: [{ taskId, dueDate }] } — only applied via apply.
  scheduleImpact          Json      @default("{}")
  effortImpactMinutes     Int?
  // Sensitive: only with projects:view_financial_fields.
  budgetImpact            Decimal?  @db.Decimal(14, 2)
  riskImpact              String?
  // Draft | Submitted | Under Review | Approved | Rejected | Scheduled | Implemented | Cancelled
  status                  String    @default("Draft")
  reviewerMembershipId    String?
  impactSnapshot          Json?
  decision                String?
  decisionReason          String?
  approvedByMembershipId  String?
  approvedAt              DateTime?
  implementedAt           DateTime?
  cancelledReason         String?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([organizationId, changeNumber])
  @@index([projectId])
  @@map("change_requests")
}

// Immutable schedule snapshot.
model ProjectBaseline {
  id                    String   @id @default(cuid())
  organizationId        String
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baselineNumber        Int
  reason                String
  snapshot              Json
  createdByMembershipId String?
  createdAt             DateTime @default(now())

  @@unique([projectId, baselineNumber])
  @@map("project_baselines")
}

// ---------------------------------------------------------------------------
// Marketing
