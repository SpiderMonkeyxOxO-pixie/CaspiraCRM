// ---------------------------------------------------------------------------
// Backend Phase 12 — analytics warehouse (star schema in the existing
// PostgreSQL; materialized aggregates live in the `analytics` schema, created
// by migration SQL). Transactional tables stay authoritative; these tables
// hold historical snapshots, events and precomputed reporting values only.
// Money: Decimal. Timestamps: UTC. businessDate: the organization's local date.
// Common fact columns: organizationId, sourceId, ownerMembershipId,
// department, team (scope before aggregation), currency/amount, baseCurrency/
// baseAmount with the rate used (never today's rate for history), isDeleted,
// sourceUpdatedAt, loadedAt, jobId.
// ---------------------------------------------------------------------------

model AnalyticsDate {
  date        DateTime @id @db.Date
  year        Int
  quarter     Int
  month       Int
  day         Int
  isoWeek     Int
  isoYear     Int
  dayOfWeek   Int
  isWeekend   Boolean
  monthStart  DateTime @db.Date
  quarterStart DateTime @db.Date

  @@map("analytics_dim_date")
}

model AnalyticsDimension {
  id              String   @id @default(cuid())
  organizationId  String
  // owner | company | contact | lead_source | pipeline | stage | product | price_book | currency |
  // country | region | project | support_queue | contract_type | payment_method | ai_provider |
  // ai_model | department | team | report | data_source
  type            String
  sourceId        String
  label           String
  currentVersionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, type, sourceId])
  @@map("analytics_dimensions")
}

// Slowly changing (type 2): a new version when tracked attributes change.
model AnalyticsDimensionVersion {
  id                 String    @id @default(cuid())
  dimensionId        String
  organizationId     String
  attributes         Json
  attributesHash     String
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isCurrent          Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  sourceUpdatedAt    DateTime?
  warehouseUpdatedAt DateTime  @default(now())

  @@index([dimensionId, isCurrent])
  @@index([organizationId, effectiveFrom])
  @@map("analytics_dimension_versions")
}

model AnalyticsMetric {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  module          String
  // Draft | Published | Retired
  status          String   @default("Draft")
  publishedVersion Int?
  latestVersion   Int      @default(1)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("analytics_metrics")
}

model AnalyticsMetricVersion {
  id              String    @id @default(cuid())
  metricId        String
  version         Int
  // { definition, formula, implementation, sources, sourceFields, filters, grain, dimensions,
  //   currencyBehavior, additivity, type, nullBehavior, owner, reviewer, permissions,
  //   sensitivity, dataQuality, freshnessTargetMinutes, unit }
  definition      Json
  checksum        String
  // Draft | Published | Retired (a published version is immutable)
  status          String    @default("Draft")
  effectiveDate   DateTime?
  deprecatedDate  DateTime?
  createdByUserId String?
  publishedByUserId String?
  createdAt       DateTime  @default(now())

  @@unique([metricId, version])
  @@map("analytics_metric_versions")
}

model AnalyticsFactLead {
  id                  String    @id @default(cuid())
  organizationId      String
  sourceId            String
  ownerMembershipId   String?
  department          String?
  team                String?
  businessDate        DateTime  @db.Date
  createdAt           DateTime
  status              String
  lifecycleStage      String?
  qualificationStatus String?
  source              String?
  country             String?
  hasContactInfo      Boolean
  qualified           Boolean
  converted           Boolean
  convertedAt         DateTime?
  convertedDate       DateTime? @db.Date
  convertedDealId     String?
  currency            String?
  estimatedValue      Decimal?  @db.Decimal(18, 2)
  isDeleted           Boolean   @default(false)
  sourceUpdatedAt     DateTime
  loadedAt            DateTime  @default(now())
  jobId               String?

  @@unique([organizationId, sourceId])
  @@index([organizationId, businessDate])
  @@index([organizationId, ownerMembershipId])
  @@map("analytics_fact_leads")
}

model AnalyticsFactActivity {
  id                   String    @id @default(cuid())
  organizationId       String
  sourceId             String
  ownerMembershipId    String?
  assignedMembershipId String?
  department           String?
  team                 String?
  businessDate         DateTime  @db.Date
  createdAt            DateTime
  type                 String
  status               String
  dueAt                DateTime?
  dueDate              DateTime? @db.Date
  completedAt          DateTime?
  completedDate        DateTime? @db.Date
  companyId            String?
  dealId               String?
  leadId               String?
