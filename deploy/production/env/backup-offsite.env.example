# Off-host pgBackRest repository (repo2) — NON-SECRET settings only.
# Copy to backup-offsite.env. Keys and the repo2 passphrase are in the
# backup_offsite_credentials secret. Use a DIFFERENT provider or region from
# the host, a bucket with versioning or object lock, and credentials that
# can't delete objects where the provider supports that.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PGBACKREST_REPO2_S3_BUCKET=caspira-backups-production
PGBACKREST_REPO2_S3_REGION=eu-central-1
PGBACKREST_REPO2_PATH=/caspira/production
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_RETENTION_FULL=8
