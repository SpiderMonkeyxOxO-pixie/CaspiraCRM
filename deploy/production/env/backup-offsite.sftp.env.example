# Off-host pgBackRest repository (repo2) over SFTP — NON-SECRET settings only.
# Used on the aaPanel database VPS, with the website VPS as the off-host copy:
#   cp env/backup-offsite.sftp.env.example env/backup-offsite.env
# The private key is the secret file secrets/production/backup_offsite_sftp_key;
# the repo2 encryption passphrase is the "cipher=" line of
# secrets/production/backup_offsite_credentials. The website VPS's SSH host
# key must be pinned in env/offsite_known_hosts (strict host-key checking).
PGBACKREST_REPO2_TYPE=sftp
# The website VPS address and SSH port (fill in).
PGBACKREST_REPO2_SFTP_HOST=
PGBACKREST_REPO2_SFTP_HOST_PORT=22
PGBACKREST_REPO2_SFTP_HOST_USER=caspira-backup
PGBACKREST_REPO2_SFTP_PRIVATE_KEY_FILE=/run/secrets/backup_offsite_sftp_key
PGBACKREST_REPO2_SFTP_KNOWN_HOST=/etc/caspira/offsite_known_hosts
PGBACKREST_REPO2_SFTP_HOST_KEY_CHECK_TYPE=strict
# Inside the SFTP-only jail on the website VPS (/srv/caspira-backup/repo).
PGBACKREST_REPO2_PATH=/repo
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_RETENTION_FULL=8
PGBACKREST_REPO2_BUNDLE=y
PGBACKREST_REPO2_BLOCK=y
