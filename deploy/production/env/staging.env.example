# Caspira CRM — STAGING settings (Backend Phase 13). NON-SECRET values only.
# Copy to production.env on the host (never commit it). Secrets are files in
# ../secrets/staging/ (see ../secrets/README.md) — never put a password,
# key or token in this file. Production has its own file and its own secrets; never share credentials, keys or OAuth apps between them. Staging never holds production customer data.

DEPLOY_ENVIRONMENT=staging

# ── Release (written by scripts/deploy.sh from the approved release manifest)
# Images are pinned by digest: repository@sha256:<64 hex>. Never a tag alone.
API_IMAGE=registry.example.com/caspira/api@sha256:<digest>
MIGRATOR_IMAGE=registry.example.com/caspira/migrator@sha256:<digest>
WEB_IMAGE=registry.example.com/caspira/web@sha256:<digest>
POSTGRES_IMAGE=registry.example.com/caspira/postgres@sha256:<digest>
PROXY_IMAGE=nginxinc/nginx-unprivileged:1.28.0-alpine3.21@sha256:a6bd0e0995ab4723fb65068665f8016decb67dc6a6a32eddc415c7d1229cada6
REDIS_IMAGE=redis:7.4.5-alpine@sha256:0302cccee2b2043e61b497c8f4075467c5f7ba27a9f38be7e092634f2734baed
# The schema version the approved deployment expects before migrating.
EXPECTED_SCHEMA_VERSION=

# ── Public addresses (HTTPS only; production and staging differ)
CLIENT_ORIGIN=https://crm.staging.example.com
PUBLIC_API_URL=https://api.staging.example.com
APP_URL=https://crm.staging.example.com
COOKIE_DOMAIN=staging.example.com
# Enable only after HTTPS is verified on every subdomain (runbook 04). No preload.
HSTS_ENABLED=false
# Separation of duties: "true" only while a single operator runs the platform;
# self-approval then needs a recorded reason and is audited as an exception.
PLATFORM_ALLOW_SINGLE_OPERATOR=false

# ── TLS: directory on the host with fullchain.pem and privkey.pem (root:root, 0750/0640)
TLS_CERT_DIR=/etc/caspira/tls/staging
ACME_WEBROOT=/var/www/caspira-acme

# ── Host groups that may read secrets and the backup control volume
SECRETS_GID=1500
BACKUP_CONTROL_GID=1600

# ── Email (provider credentials: secrets/staging/smtp_password)
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USER=caspira-staging
SMTP_SECURE=false
SMTP_FROM=Caspira CRM <no-reply@staging.example.com>

# ── Operations
AUDIT_LOG_RETENTION_DAYS=180
# Labels only: where the backups go (credentials are secrets).
BACKUP_REPO_PRIMARY=repo1:pgbackrest-volume
BACKUP_REPO_OFFSITE=repo2:s3-versioned
BACKUP_OFFSITE_ENABLED=true
RESTORE_TARGET_TTL_HOURS=24
DB_CONNECTION_LIMIT=15
AI_MODE=live
