# Caspira CRM — PRODUCTION on the aaPanel database VPS (Backend Phase 13).
# NON-SECRET values only. On the VPS:
#   cp env/aapanel-production.env.example env/production.env
# Secrets are files in ../secrets/production/ (scripts/create-secrets.sh);
# never put a password, key or token in this file. The images are written
# by scripts/build-local.sh into env/production.release.env, not here.

DEPLOY_ENVIRONMENT=production

# The core stack plus the aaPanel edge layer (no proxy/web of our own).
COMPOSE_LAYERS="compose.yaml compose.aapanel.yaml"
# Images are built on this VPS from an exact commit and verified by image ID.
IMAGE_SOURCE=local
# Pinned third-party image (pulled by digest).
REDIS_IMAGE=redis:7.4.5-alpine@sha256:0302cccee2b2043e61b497c8f4075467c5f7ba27a9f38be7e092634f2734baed

# ── Public addresses (unchanged from the current production setup)
CLIENT_ORIGIN=https://caspiracrm.caspirasolutions.com
PUBLIC_API_URL=https://api.caspirasolutions.com
APP_URL=https://caspiracrm.caspirasolutions.com
COOKIE_DOMAIN=caspirasolutions.com
# Cloudflare, then aaPanel's nginx, in front of the api.
TRUST_PROXY_HOPS=2
# HTTPS is terminated by Cloudflare/aaPanel; leave HSTS to Cloudflare for now.
HSTS_ENABLED=false

# ── Host groups that may read secrets and the backup control volume
SECRETS_GID=1500
BACKUP_CONTROL_GID=1600

# ── Email: captured by the Mailpit container (not delivered), as today.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Caspira CRM <no-reply@caspirasolutions.com>

# ── Operations
AUDIT_LOG_RETENTION_DAYS=730
# Labels only: where the backups go (credentials are secrets).
BACKUP_REPO_PRIMARY=repo1:pgbackrest-volume
BACKUP_REPO_OFFSITE=repo2:sftp-website-vps
BACKUP_OFFSITE_ENABLED=true
RESTORE_TARGET_TTL_HOURS=24
DB_CONNECTION_LIMIT=15
AI_MODE=live
