# Production settings for deploy/vps-prod. Copy to .env (git-ignored) and
# fill in every "change-me". Generate secrets on the VPS with:
#   openssl rand -hex 32
# (hex only — the database password is embedded in a connection URL, so it
# must not contain @ : / ? # characters).

# --- Database (new, production-only — never reuse the dev password) ---
POSTGRES_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# The live site's address, exactly as users open it (https, no trailing
# slash) — the only origin the api accepts browser requests from.
CLIENT_ORIGIN=https://caspiracrm.caspirasolutions.com

# The site (caspiracrm.) and the api (api.) are sibling subdomains; the
# CSRF cookie is shared between them through the parent domain.
COOKIE_DOMAIN=caspirasolutions.com

# Proxies in front of the api: Cloudflare, then this VPS's nginx. Lets the
# api see real client IPs (login rate limits, audit events).
TRUST_PROXY=2

# --- Email ---
# Defaults to the Mailpit container (mail is captured, not delivered).
# For real delivery set your provider's host/port here.
# SMTP_HOST=
# SMTP_PORT=
SMTP_FROM="Caspira CRM <no-reply@caspirasolutions.com>"

# --- AI gateway (optional — blank means "not configured") ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- One-time System Owner bootstrap (see docs/VPS_PROD_SETUP.md) ---
# Leave these commented out; pass them only on the bootstrap command line.
# ALLOW_SYSTEM_OWNER_BOOTSTRAP=true
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_USERNAME=
# BOOTSTRAP_OWNER_PASSWORD=

# --- Integrations (Backend Phase 8) ---
# live | simulator. Production must be "live"; simulator is local dev only.
INTEGRATIONS_MODE=live
# Master encryption keyring for provider credentials: "1:<base64 32 bytes>".
# It lives only here (or in a Docker secret via INTEGRATIONS_KEYS_FILE) —
# never in the database. The api and worker refuse to start without it.
# Generate one with:  openssl rand -base64 32
# Rotation: add "2:<new key>", set INTEGRATIONS_ACTIVE_KEY_VERSION=2,
# restart, run `npm run integrations:verify-encryption -- --rewrap`, then
# remove version 1. See docs/BACKEND_PHASE8.md.
INTEGRATIONS_KEYS=
# INTEGRATIONS_ACTIVE_KEY_VERSION=1
# Public base URL providers call back to (OAuth redirect and webhooks).
INTEGRATIONS_PUBLIC_API_URL=https://api.caspirasolutions.com
# Where the browser is sent after an OAuth callback (pre-registered only).
INTEGRATIONS_FRONTEND_URL=https://caspiracrm.caspirasolutions.com